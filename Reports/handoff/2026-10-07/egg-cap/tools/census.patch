+/// **Round an ant's head, within the egg pile's reach of 4**: brood cells,
+/// loose food cells, empty cells touching the dug home, and other animals'
+/// cells; and whether the pile's walk would find an empty dug-home cell if it
+/// could also pass through brood (the pile walk passes only empty cells and
+/// animals). Home here is the dug home alone, an approximation of
+/// `creature::home_at` that leaves out the storeroom and site branches.
+fn lay_census(w: &World, (hx, hy): (i32, i32)) -> (u32, u32, u32, u32, bool) {
+    const R: i32 = 4;
+    let brood = w.materials.id_of("brood");
+    let me = w.get(hx, hy).organism_id();
+    let dug = |x: i32, y: i32| (-1..=1).any(|dy| (-1..=1).any(|dx| w.nest_dug.contains(&(x + dx, y + dy))));
+    let (mut nb, mut nf, mut ne, mut na) = (0, 0, 0, 0);
+    for y in hy - R..=hy + R {
+        for x in hx - R..=hx + R {
+            if !w.in_bounds(x, y) || (x, y) == (hx, hy) {
+                continue;
+            }
+            let c = w.get(x, y);
+            if Some(c.material) == brood {
+                nb += 1;
+            } else if w.materials.kind(c.material) == MaterialKind::Creature {
+                na += u32::from(c.organism_id() != me);
+            } else if c.material == material::EMPTY {
+                ne += u32::from(dug(x, y));
+            } else if c.organism_id() == 0 && creature::food_value(w, c) > 0.0 {
+                nf += 1;
+            }
+        }
+    }
+    let side = (2 * R + 1) as usize;
+    let mut seen = vec![false; side * side];
+    let idx = |x: i32, y: i32| ((y - hy + R) as usize) * side + (x - hx + R) as usize;
+    seen[idx(hx, hy)] = true;
+    let mut frontier = vec![(hx, hy)];
+    let mut found = false;
+    'walk: for _ in 1..=R {
+        let mut next = Vec::new();
+        for &(x, y) in &frontier {
+            for (dx, dy) in DIRS {
+                let (nx, ny) = (x + dx, y + dy);
+                if (nx - hx).abs() > R || (ny - hy).abs() > R || !w.in_bounds(nx, ny) || seen[idx(nx, ny)] {
+                    continue;
+                }
+                seen[idx(nx, ny)] = true;
+                let c = w.get(nx, ny);
+                let empty = c.material == material::EMPTY;
+                if !empty && w.materials.kind(c.material) != MaterialKind::Creature && Some(c.material) != brood {
+                    continue;
+                }
+                if empty && dug(nx, ny) {
+                    found = true;
+                    break 'walk;
+                }
+                next.push((nx, ny));
+            }
+        }
+        frontier = next;
+    }
+    (nb, nf, ne, na, found)
+}
