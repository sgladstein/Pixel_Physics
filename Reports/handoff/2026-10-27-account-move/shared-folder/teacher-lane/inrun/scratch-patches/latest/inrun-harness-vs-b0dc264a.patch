+                    q_now = q;
+                    cut = zs.iter().filter(|p| z(&book[&p.0]) < -zhard).map(|p| p.0).collect();
+                    let hard = cut.len();
+                    hard_n = hard;
+                    let extra_cut = n.saturating_sub(hi);
+                    for p in &zs {
+                        if cut.len() >= hard + extra_cut || p.1 >= 0.0 {
+                            break;
+                        }
+                        if !cut.contains(&p.0) {
+                            cut.push(p.0);
+                        }
+                    }
