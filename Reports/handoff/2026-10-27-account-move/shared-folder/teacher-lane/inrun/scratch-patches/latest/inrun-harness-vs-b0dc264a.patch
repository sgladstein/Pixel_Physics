+                    let mut kids = vec![0u32; ok.len()];
+                    let mut given = 0;
+                    'passes: for span in [ok.len(), ok.len().div_ceil(2), ok.len().div_ceil(4)] {
+                        for k in kids.iter_mut().take(span) {
+                            if given >= want {
+                                break 'passes;
+                            }
+                            *k += 1;
+                            given += 1;
+                        }
+                    }
+                    if want > 0 {
+                        q_due += 1;
+                        if ok.is_empty() {
+                            q_noparent += 1;
+                        }
+                    }
+                    parents = ok.into_iter().zip(kids).filter(|p| p.1 > 0).collect();
