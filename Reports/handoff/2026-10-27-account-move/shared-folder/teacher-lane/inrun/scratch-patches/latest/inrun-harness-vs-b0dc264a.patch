+                                Some(i) => (book[&i].genome.clone(), book[&i].family.clone(), book[&i].gen, i),
+                                None => {
+                                    let h = &hall[c.2];
+                                    (h.2.genome.clone(), h.2.family.clone(), h.2.gen, 0)
+                                }
+                            };
