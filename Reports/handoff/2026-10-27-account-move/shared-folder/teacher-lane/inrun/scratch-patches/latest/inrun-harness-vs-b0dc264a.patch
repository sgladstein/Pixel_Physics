+                        for k in (1..cand.len()).rev() {
+                            cand.swap(k, srng.below(k + 1));
+                        }
+                    } else {
+                        cand.sort_by(|a, b| b.0.partial_cmp(&a.0).unwrap().then(a.1.cmp(&b.1)).then(a.2.cmp(&b.2)));
