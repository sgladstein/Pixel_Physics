diff --git a/examples/copylog.rs b/examples/copylog.rs
new file mode 100644
index 00000000..10b5b317
--- /dev/null
+++ b/examples/copylog.rs
@@ -0,0 +1,83 @@
+//! SCRATCH (teacher-training step 1, not for main): run one genome on a set of training-style worlds with the copier's
+//! log on, and write each world's score.
+//!
+//! cargo run --release --example copylog -- <soil|fetch|trail> <genome> <run_seed> <n> <out.csv> [threads]
+//!
+//! The genome is loaded **through the suite** (soil 8 rows, fetch, trail -- the dig-8 runs' arenas), as training would
+//! load it, so no arena's bans are baked in; each arena applies its own when it runs. `PP_GENOME_OUT=<file>` saves the
+//! genome as loaded (the copier's starting point). `PP_COPY_LOG=<file>` turns the log on; `PP_TEACH_LABEL=1` adds the
+//! teacher's state labels (soil only). Worlds are `train::training_layouts(run_seed, 0, n)`: pick run seeds that no
+//! other set uses (the 96 evaluation worlds are 9001 and 9002).
+use pixel_physics::sim::creature;
+use pixel_physics::sim::creature::mind::scratch_log;
+use pixel_physics::train::challenges::{Scarce, Soil, Suite, Trail};
+use pixel_physics::train::{self, Challenge};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::Mutex;
+
+fn soil() -> Soil {
+    Soil { ants: 1, frames: 12000, step: 4, shaft: 8, budget: Some(2400.0), foot: true, step_near: 0.0 }
+}
+fn fetch() -> Scarce {
+    Scarce {
+        ants: 1,
+        frames: 6000,
+        drip: 5,
+        every: 1000,
+        game_walk: false,
+        brake: Some(creature::FoodBrake::FORAGE),
+        dist: (10, 30),
+        steps: true,
+        fed: true,
+        dig: false,
+    }
+}
+fn trail() -> Trail {
+    Trail { ants: 6, frames: 6000, clones: false }
+}
+
+fn main() {
+    std::env::set_var("PIXEL_PHYSICS_MUTATION", "off");
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let (arena, genome, run_seed, n, out) = (a[0].as_str(), a[1].as_str(), a[2].parse::<u64>().unwrap(), a[3].parse::<usize>().unwrap(), a[4].as_str());
+    let threads = a.get(5).map_or_else(|| std::thread::available_parallelism().map_or(4, |n| n.get()), |t| t.parse().unwrap());
+    let suite = Suite::new(vec![(Box::new(soil()), false), (Box::new(fetch()), true), (Box::new(trail()), true)], 0.8);
+    let g = train::start_mind(&suite, genome);
+    if let Ok(p) = std::env::var("PP_GENOME_OUT") {
+        train::save_genome(std::path::Path::new(&p), &g).unwrap();
+    }
+    let ch: Box<dyn Challenge> = match arena {
+        "soil" => Box::new(soil()),
+        "fetch" => Box::new(fetch()),
+        "trail" => Box::new(trail()),
+        _ => panic!("arena: soil|fetch|trail"),
+    };
+    let lays = train::training_layouts(run_seed, 0, n);
+    println!(
+        "copylog: {arena}, {genome}, run seed {run_seed}, {n} worlds, {threads} threads, copy log {}, labels {}",
+        scratch_log::copy_on(),
+        scratch_log::label_on()
+    );
+    let next = AtomicUsize::new(0);
+    let res = Mutex::new(Vec::new());
+    std::thread::scope(|sc| {
+        for _ in 0..threads {
+            sc.spawn(|| loop {
+                let k = next.fetch_add(1, Ordering::Relaxed);
+                let Some(&lay) = lays.get(k) else { break };
+                scratch_log::WORLD.with(|w| w.set(k as u64));
+                let r = ch.run(lay, &[g.as_slice()], &mut |_, _| {});
+                let full = if arena == "soil" { r[0].parts[24] } else { f64::NAN };
+                res.lock().unwrap().push((k, lay.seed, r[0].fit, full));
+            });
+        }
+    });
+    scratch_log::copy_flush();
+    let mut v = res.into_inner().unwrap();
+    v.sort_by_key(|r| r.0);
+    let rows: Vec<String> = v.iter().map(|(k, s, f, l)| format!("{k},{s},{f},{l}")).collect();
+    std::fs::write(out, format!("world,seed,score,full_loads\n{}\n", rows.join("\n"))).unwrap();
+    let mean = v.iter().map(|r| r.2).sum::<f64>() / v.len() as f64;
+    println!("wrote {out}: mean score {mean:.3}");
+    println!("{}", scratch_log::teach_report());
+}
diff --git a/examples/copyreplay.rs b/examples/copyreplay.rs
new file mode 100644
index 00000000..0dddb467
--- /dev/null
+++ b/examples/copyreplay.rs
@@ -0,0 +1,60 @@
+//! SCRATCH (teacher-training step 1, not for main): the copier's reference. Re-runs the brain's own `mind::decide` on
+//! the states in a copy log, with ANY genome, and writes every option's score and every verb's job score -- so the
+//! Python forward pass can be checked against the real thing on a genome it was not fitted to.
+//!
+//! cargo run --release --example copyreplay -- <copy log> <genome as loaded> <out> [max rows]
+//!
+//! The genome is read raw (`train::load_genome`), not through a challenge: it must be exactly the vector the copier
+//! holds. Out: one line per Q row, `tag,frame,id|score score ...|job job ...` (`nan` for a verb with no job).
+use pixel_physics::sim::creature::mind::{self, MindState};
+use pixel_physics::sim::creature::options::{Opt, Verb, FEATURES};
+use pixel_physics::sim::rng::Rng;
+use pixel_physics::train;
+use std::io::{BufRead, Write};
+
+fn main() {
+    let a: Vec<String> = std::env::args().skip(1).collect();
+    let (log, genome, out) = (&a[0], &a[1], &a[2]);
+    let max: usize = a.get(3).map_or(usize::MAX, |m| m.parse().unwrap());
+    let g = train::load_genome(std::path::Path::new(genome), mind::GENOME_LEN);
+    let mut w = std::io::BufWriter::new(std::fs::File::create(out).unwrap());
+    let mut done = 0;
+    for line in std::io::BufReader::new(std::fs::File::open(log).unwrap()).lines() {
+        let line = line.unwrap();
+        let p: Vec<&str> = line.split(',').collect();
+        if p.get(1) != Some(&"Q") {
+            continue;
+        }
+        // tag,Q,frame,id,x,y,settle,pick,last,carrying,labels,ctx,mem0,opts
+        let last: i32 = p[8].parse().unwrap();
+        let ctx: Vec<f32> = p[11].split(' ').map(|x| x.parse().unwrap()).collect();
+        let mem: Vec<f32> = p[12].split(' ').map(|x| x.parse().unwrap()).collect();
+        let opts: Vec<Opt> = p[13]
+            .split(';')
+            .filter(|o| !o.is_empty())
+            .map(|o| {
+                let q: Vec<&str> = o.splitn(5, ':').collect();
+                let mut feats = [0.0f32; FEATURES];
+                for kv in q[4].split(' ').filter(|s| !s.is_empty()) {
+                    let (i, v) = kv.split_once('=').unwrap();
+                    feats[i.parse::<usize>().unwrap()] = v.parse().unwrap();
+                }
+                Opt { verb: Verb::ALL[q[0].parse::<usize>().unwrap()], target: (q[1].parse().unwrap(), q[2].parse().unwrap()), feats }
+            })
+            .collect();
+        let mut state = MindState::default();
+        state.mem.copy_from_slice(&mem);
+        state.last_verb = (last >= 0).then(|| Verb::ALL[last as usize]);
+        let ctx: [f32; mind::CONTEXT] = ctx.try_into().unwrap();
+        let mut draw = Rng::new(1);
+        let Some(d) = mind::decide(&g, &ctx, &opts, &mut state, &mut draw) else { continue };
+        let s: Vec<String> = d.scores.iter().map(|x| format!("{x}")).collect();
+        let j: Vec<String> = d.jobs.iter().map(|x| x.map_or("nan".into(), |v| format!("{v}"))).collect();
+        writeln!(w, "{},{},{}|{}|{}", p[0], p[2], p[3], s.join(" "), j.join(" ")).unwrap();
+        done += 1;
+        if done >= max {
+            break;
+        }
+    }
+    println!("replayed {done} decisions into {out}");
+}
