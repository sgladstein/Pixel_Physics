+    if kind == 'lab':
+        return c * 1000 + r * 10 + k if r < 100 else 20_000_000 + c * 10_000 + r * 10 + k
+    if kind == 'labcase':
+        return 30_000_000 + c * 100_000 + r * 100 + k
+    raise ValueError(kind)
