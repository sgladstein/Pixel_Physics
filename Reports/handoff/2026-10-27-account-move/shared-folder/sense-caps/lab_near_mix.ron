// SCRATCH (teacher lane, 2026-10-24): a lab box for colsel.py's +lab case (examples/labsurvive.rs): the steady-income
// bed (no plants, mister off), 52 ants landing at column 256 on frame 6,000 on one tank, two food heaps 150 columns out (provisions east, fruit west) that
// are there on landing and topped up 20 cells each every 500 frames. The trained pool of 2026-10-24 lived with food
// 10-50 columns out and starved to the last ant at 100-240 (the hand-built ant lived at all of them).
(
    name: "lab_near_mix",
    title: "FAR FOOD, MIXED",
    question: "Food arrives at a fixed rate: does the colony settle at the size the income carries, or swing between boom and famine?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 80,
        ground_y: 160,
        compartments: 1,
        founders: 0,
        species: "grass",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [
        (subject: "the bed", field: "rain", value: 0),
    ],
    placements: [],
    timeline: [
        (at: 6000, every: 0, until: 0, what: Colony(species: "ant", x: 256, count: 52)),
        (at: 5990, every: 0, until: 0, what: Heap(material: "fruit", x: 231, cells: 60)),
        (at: 5990, every: 0, until: 0, what: Heap(material: "provisions", x: 281, cells: 60)),
        (at: 6500, every: 500, until: 0, what: Heap(material: "fruit", x: 231, cells: 20)),
        (at: 6500, every: 500, until: 0, what: Heap(material: "provisions", x: 281, cells: 20)),
    ],
    horizon: 600000,
)
