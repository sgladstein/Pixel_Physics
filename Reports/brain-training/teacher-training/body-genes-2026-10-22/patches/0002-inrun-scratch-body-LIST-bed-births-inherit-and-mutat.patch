+/// One ant's body genes (`state.traits`), every slot.
+type Body = [f32; organism::CREATURE_TRAITS];
+
+/// `body=default`: the slots a mind ant in this bed both reads and pays for in both directions (body-genes thread,
+/// 2026-10-22). Left out, and why: birth_grant and reproduce_at (this bed does not breed by the body: the harness
+/// places children and sets their grants); sight_range and curvature_radius (a mind casts no rays, so neither is read
+/// nor billed); the walk, trail-plane, door and forage-memory genes (read only by the game ant's own walk and `act`,
+/// which a mind replaces); armour (billed every tick and never bitten here, so it could only fall); dig_force (one
+/// step down from 1.0 below packed soil's 0.95 leaves an ant that cannot cut spoil -- a cheap jaw selection would take
+/// while digging is already being bred out).
+const BODY_DEFAULT: [&str; 5] = ["appetite", "digest_rate", "crop_capacity", "gut_bias", "pace"];
+
+/// A child's body under `body=`: the parent's open genes on the child's placed body, mutated by the game's own birth
+/// rule on the child's own stream, logged; without `body=`, the placed body untouched.
+#[allow(clippy::too_many_arguments)]
+fn child_body(w: &mut pixel_physics::sim::World, cid: u32, def: &organism::CreatureDef, open: &[(usize, f32)], parent: Body, frame: u64, pid: u32, log: &mut Option<std::io::BufWriter<std::fs::File>>) -> Body {
+    let mut b = w.organism(cid).map_or(parent, |st| st.traits);
+    if open.is_empty() {
+        return b;
+    }
+    for &(s, _) in open {
+        b[s] = parent[s];
+    }
+    let b = creature::inherit_body(w, cid, def, b, true);
+    if let Some(f) = log.as_mut() {
+        writeln!(f, "{frame},{cid},{pid},{}", open.iter().map(|o| format!("{:.4}", b[o.0])).collect::<Vec<_>>().join(",")).unwrap();
+    }
+    b
+}
+
+fn save_body(path: &std::path::Path, b: &Body) {
+    let s: Vec<String> = b.iter().map(|v| format!("{v}")).collect();
+    std::fs::write(path, format!("body {}\n{}\n", b.len(), s.join(" "))).unwrap();
+}
+
+fn load_body(path: &std::path::Path) -> Option<Body> {
+    let text = std::fs::read_to_string(path).ok()?;
+    let v: Vec<f32> = text.lines().nth(1)?.split_whitespace().map(|x| x.parse().unwrap()).collect();
+    let mut b = [0.0; organism::CREATURE_TRAITS];
+    for (slot, x) in b.iter_mut().zip(v) {
+        *slot = x;
+    }
+    Some(b)
+}
