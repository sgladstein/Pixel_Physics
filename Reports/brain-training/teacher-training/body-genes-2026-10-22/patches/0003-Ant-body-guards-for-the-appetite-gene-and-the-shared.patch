+"""SCRATCH (body-genes thread, 2026-10-22). evreduce.py's rows from a LOCAL batch dir (DIR/<job>/r<k>/), for pairfood.py.
+usage: localreduce.py DIR OUTCSV"""
+import sys, os, csv, glob, gzip, re, collections
+D, OUT = sys.argv[1], sys.argv[2]
+rows = []
+for jd in sorted(glob.glob(D + '/*_*')):
+    job = os.path.basename(jd)
+    for rd in sorted(glob.glob(jd + '/r*'), key=lambda p: int(p.rsplit('r', 1)[1])):
+        rr = int(rd.rsplit('r', 1)[1])
+        evf = rd + '/events.csv' if os.path.exists(rd + '/events.csv') else rd + '/events.csv.gz'
+        if not os.path.exists(evf): continue
+        c = collections.Counter(); last = 0
+        for e in csv.DictReader(gzip.open(evf, 'rt') if evf.endswith('.gz') else open(evf)):
+            k = e['kind']; last = max(last, int(e['frame']))
+            if k == 'deliver':
+                dx = abs(int(e['x']) - 128); c['deliver'] += 1; c['deliver_far'] += dx >= 13; c['deliver_home8'] += dx <= 8
+            elif k in ('field', 'homeeat', 'hungryout', 'tdrop'): c[k] += 1
+            elif k == 'death': c['starved'] += e['v'] == '1'; c['culled'] += e['v'] == '4'
+        af = rd + '/ants_f0200000.txt'
+        alive = sum(1 for _ in open(af)) if os.path.exists(af) else -1
+        rows.append(['local', job, rr, last, c['deliver'], c['deliver_far'], c['field'], c['homeeat'], c['hungryout'], c['tdrop'], c['starved'], c['culled'], alive, c['deliver_home8']])
+with open(OUT, 'w', newline='') as f:
+    w = csv.writer(f); w.writerow(['batch','job','round','lastframe','deliver','deliver_far','field','homeeat','hungryout','tdrop','starved','culled','alive_end','deliver_home8'])
+    w.writerows(rows)
+print(len(rows), 'colony-rounds')
