+"""SCRATCH (body-genes thread, 2026-10-22). Where selection takes the open body genes, per arm and round.
+usage: bodydrift.py DIR   (DIR/<arm>_<seed>/r<k>/body.csv and final/*.body.txt; a local batch or a `pull` of small copies)
+Per arm and round: the mean over seeds of each colony's mean of every ant born that round, and of the round's survivors
+(final/, the next round's founders). Slot order of a body file is organism::CREATURE_TRAITS'."""
+import sys, os, csv, glob, re, statistics as st, collections
+D = sys.argv[1]
+SLOT = {'gut_bias': 0, 'pace': 4, 'dig_force': 6, 'digest_rate': 7, 'crop_capacity': 8, 'armour': 9, 'appetite': 27}
+by = collections.defaultdict(lambda: collections.defaultdict(lambda: collections.defaultdict(list)))
+genes_of = {}
+for jd in glob.glob(D + '/*_*'):
+    arm = re.sub(r'_\d+$', '', os.path.basename(jd))
+    for rd in glob.glob(jd + '/r*'):
+        bf = rd + '/body.csv'
+        if not os.path.exists(bf): continue
+        rr = int(rd.rsplit('r', 1)[1])
+        rows = [r for r in csv.DictReader(open(bf)) if r['frame'] != '0']
+        genes = [k for k in csv.DictReader(open(bf)).fieldnames if k not in ('frame', 'id', 'parent')]
+        genes_of[arm] = genes
+        for g in genes:
+            if rows: by[arm][rr]['born:' + g].append(st.mean(float(r[g]) for r in rows))
+        fin = glob.glob(rd + '/final/*.body.txt')
+        for g in genes:
+            v = [float(open(f).read().split('\n')[1].split()[SLOT[g]]) for f in fin if g in SLOT]
+            if v: by[arm][rr]['kept:' + g].append(st.mean(v))
+for arm in sorted(by):
+    genes = genes_of[arm]
+    print(f'== {arm}: mean allele over seeds (born that round / survivors at its end); n = colonies')
+    print('round  ' + '  '.join(f'{g[:13]:>17s}' for g in genes) + '   n')
+    for rr in sorted(by[arm]):
+        d = by[arm][rr]
+        print(f'r{rr:<5d}' + '  '.join(f"{(st.mean(d['born:'+g]) if d['born:'+g] else float('nan')):+8.3f}/{(st.mean(d['kept:'+g]) if d['kept:'+g] else float('nan')):+8.3f}" for g in genes) + f"  {len(d['kept:'+genes[0]])}")
