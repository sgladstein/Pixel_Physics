+    impl TeachCtx {
+        fn ground0(&self, x: i32, y: i32) -> bool {
+            let (i, j) = (x - self.x0, y - self.y0);
+            i >= 0 && j >= 0 && (i as usize) < self.nw && (j as usize) < self.nh && self.ground0[j as usize * self.nw + i as usize]
+        }
