+                let deepest = *walks.iter().max_by_key(|&&i| (t.depth(opts[i].target.0, opts[i].target.1), -(opts[i].target.0 - at.0).abs()))?;
+                let dd = t.depth(opts[deepest].target.0, opts[deepest].target.1);
