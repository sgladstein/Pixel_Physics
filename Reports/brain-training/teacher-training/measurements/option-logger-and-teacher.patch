+    }
+    /// Obedience among `labelled` options against `others`, at saturation `sat()`.
+    fn obey(labelled: usize, others: usize) -> f32 {
+        let hi = (PICK_FLOOR + (1.0 + sat()) / 2.0).powi(2);
