From fa8fcc8f37569899fd62eb23cddbedd19478cbaa Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 16:55:06 +0000
Subject: [PATCH] inrun: inherit_nest lines the carved nest (the inherited
 sinkhole)

What it fixes: a round that inherits last round's nest (inherit_nest=1) lost
a band of soil under the surface within 10 frames, with no ant digging. The
kept nest cells were carved EMPTY into the fresh world's loose soil, and loose
soil is a powder: every carved hole filled from above and the voids rose to
the surface. Only packed soil spans a hole, and the ants that dug the nest had
tamped every wall as they cut it; the carve had not. Copying the old map's
lining could not help, because the crater rule keeps only the roofed edges of
a crater-topped room, and their inner wall is loose soil in the fresh world.

Fix (setup only, no physics change): after the carve, every kept cell is
lined by the same rule as an ant cut and the founding shaft
(pack_neighbours, via a new World::line_dug_cell). Also, in nest-only mode a
kept '?' cell (an ant or stored food standing in an open nest cell) is now
carved too; it used to be left as fresh loose soil, a plug in the tunnel.

Measured (192 end-of-round maps, nestmaps-1022 cs3lex/cs3lexles/cs3lexlesinh,
one old ant, no digs, 3000 frames; within 60 columns of the door):
  carved holes refilled:   median 74, p90 187  ->  median 0, p90 6
  ground emptied:          median 59, p90 143  ->  median 6, p90 10
  open cells, top 6 rows within 20 cols of the door: 22 -> 66 (today)
                                                     22 -> 22 (fixed)
cs3lexlesinh c5: 138 ground cells emptied and 190 carved cells refilled by
frame 10 today; 0 and 0 through frame 400 with the lining.

Changes results only for inherit_nest=1 runs. INHERIT_LINE=0 and
INHERIT_PLUG=1 restore the old carve for before/after.

Still open, not fixed here: in most maps the carved nest is not joined to the
door (median 115 open cells carved, 30 joined): the room's link to the door
ran through the crater, which is deliberately not inherited.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QoZheBsv94QtqS9fSdo1hV
---
 examples/inrun.rs   | 24 +++++++++++++++++++++++-
 src/sim/creature.rs | 20 ++++++++++++++++++++
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/examples/inrun.rs b/examples/inrun.rs
index 4f2f3f63..6d74bda8 100644
--- a/examples/inrun.rs
+++ b/examples/inrun.rs
@@ -177,7 +177,12 @@ fn read_nestmap(w: &mut pixel_physics::sim::World, path: &str, nest_only: Option
     let mut n = 0;
     for (dy, row) in grid.iter().enumerate() {
         for (dx, &ch) in row.iter().enumerate() {
-            if ch == b'?' || keep.as_ref().is_some_and(|k| !k.contains(&(dx, dy))) {
+            // `?` (an animal, food, an organism's cell) is left to the fresh world -- except, in nest-only mode, a kept
+            // one: the flood passed it because it is not ground, so it stood in an open nest cell (an ant in a tunnel,
+            // stored food in a room), and leaving it the fresh world's loose soil plugged the nest at every one of them.
+            // `INHERIT_PLUG=1` puts the plugs back, for the before/after.
+            let plug = std::env::var("INHERIT_PLUG").as_deref() == Ok("1");
+            if (ch == b'?' && (keep.is_none() || plug)) || keep.as_ref().is_some_and(|k| !k.contains(&(dx, dy))) {
                 continue;
             }
             let (x, y) = (x0 + dx as i32, y0 + dy as i32);
@@ -194,6 +199,23 @@ fn read_nestmap(w: &mut pixel_physics::sim::World, path: &str, nest_only: Option
             n += 1;
         }
     }
+    // Line the carved nest, as the ants that dug it did and as the stamp's founding shaft is lined. Carved into the fresh
+    // world's loose soil with nothing tamped, every kept hole was a void under a powder: the old map's lining is no use
+    // here, because the crater rule above keeps only the roofed edges of a crater-topped room, and their inner wall is
+    // the crater's place in the fresh world -- loose soil. Measured 2026-10-23 (cs3lexlesinh c5, one old ant): 172 kept
+    // cells filled from above inside 400 frames and the voids came out at the surface, two rows lost across 80 columns.
+    // One pass after the carve, the founding shaft's order (sorted: `keep` is a HashSet). Kept cells holding an
+    // organism are left alone. `INHERIT_LINE=0` turns it off, for the before/after.
+    if let Some(k) = keep.as_ref().filter(|_| std::env::var("INHERIT_LINE").as_deref() != Ok("0")) {
+        let mut cells: Vec<_> = k.iter().copied().collect();
+        cells.sort_unstable();
+        for (dx, dy) in cells {
+            let (x, y) = (x0 + dx as i32, y0 + dy as i32);
+            if w.get(x, y).material == pixel_physics::sim::material::EMPTY {
+                w.line_dug_cell(x, y);
+            }
+        }
+    }
     n
 }
 
diff --git a/src/sim/creature.rs b/src/sim/creature.rs
index 4e9e350d..f75fd7f3 100644
--- a/src/sim/creature.rs
+++ b/src/sim/creature.rs
@@ -7098,6 +7098,26 @@ impl World {
         cut.len()
     }
 
+    /// **Line the walls of a hole a harness opened by hand**, by the same rule
+    /// the founding shaft and every ant cut use ([`pack_neighbours`]), and
+    /// only where tunnel lining is on at all. Returns how many cells it packed.
+    ///
+    /// For a setup that carves a whole burrow into fresh ground at once --
+    /// `examples/inrun.rs`'s `inherit_nest=1`, which carries last round's nest
+    /// into a new world. A hole carved into loose soil with no lining is not a
+    /// nest, it is a void under a powder: measured 2026-10-23 on the
+    /// cs3lexlesinh c5 map, 172 carved cells filled from above inside 400
+    /// frames and the hole came out as a sinkhole two rows deep across 80
+    /// columns of surface. The ants that dug it had tamped every wall as they
+    /// cut; carving the hole without the tamping is a different hole.
+    /// Not counted in `CreatureStats::packed`, which is wall an *ant* tamped.
+    pub fn line_dug_cell(&mut self, x: i32, y: i32) -> u64 {
+        if !lining_enabled() {
+            return 0;
+        }
+        pack_neighbours(self, x, y)
+    }
+
     /// **The hardest ground a founding shaft may cut when nobody says whose
     /// founding it is**: the strongest authored `dig_force` among the species
     /// whose `nest` is the material [`World::paint_nest_patch`] lays -- the
