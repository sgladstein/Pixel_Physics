+/// SCRATCH (dig-scoring thread, 2026-10-22): `roomshape.py`'s score of the live nest, for `w_shape` (pay a cut by how
+/// much it moved the nest toward multiple rooms). Same rule, same window as the end-of-round `nestmap.txt`, so the two
+/// agree on a map (checked at the end of every run with `w_shape`, `shape` line in `sel.csv`'s log): the space is every
+/// open cell joined to the door below the datum, its sky-open part (beyond the door's 3 columns) is crater and never a
+/// room; rooms are the 4-connected pieces of the 5x5 opening; each room after the biggest scores min(cells, 50) / 2,
+/// and each other piece scores its reach from the body (main room + door path + crater) minus 2, capped at 15, best 4.
+/// `shut` treats one cell as ground: the score before that cell was cut.
+fn shape_score(w: &pixel_physics::sim::World, surf: &[i32], shut: Option<(i32, i32)>) -> f64 {
+    use pixel_physics::sim::material;
+    use std::collections::VecDeque;
+    let (hw, y0, y1) = NESTMAP;
+    let (x0, wd, ht) = (inrun::NEST - hw, 2 * hw + 1, y1 - y0);
+    let idx = |x: i32, y: i32| ((y - y0) * wd + (x - x0)) as usize;
+    let inside = |x: i32, y: i32| x >= x0 && x < x0 + wd && y >= y0 && y < y1;
+    let (empty, spoil, food) = (w.materials.id_of("empty"), w.materials.id_of("spoil"), w.materials.id_of("provisions"));
+    let n = (wd * ht) as usize;
+    let (mut open, mut sp) = (vec![false; n], vec![false; n]);
+    for y in y0..y1 {
+        for x in x0..x0 + wd {
+            if shut == Some((x, y)) {
+                continue;
+            }
+            let c = w.get(x, y);
+            let o = c.organism_id() != 0 || Some(c.material) == food || Some(c.material) == empty
+                || w.materials.kind(c.material) == material::MaterialKind::Creature;
+            open[idx(x, y)] = o;
+            sp[idx(x, y)] = !o && Some(c.material) == spoil && y >= surf[x as usize];
+        }
+    }
+    let below = |x: i32, y: i32| y >= surf[x as usize];
+    const N4: [(i32, i32); 4] = [(1, 0), (-1, 0), (0, 1), (0, -1)];
+    // the space: open, below the datum, joined to the door's column
+    let door = inrun::NEST;
+    let mut space = vec![false; n];
+    let mut st: Vec<(i32, i32)> = (y0..y1).filter(|&y| open[idx(door, y)] && below(door, y)).map(|y| (door, y)).collect();
+    while let Some((x, y)) = st.pop() {
+        if space[idx(x, y)] {
+            continue;
+        }
+        space[idx(x, y)] = true;
+        for (a, b) in N4 {
+            let (qx, qy) = (x + a, y + b);
+            if inside(qx, qy) && open[idx(qx, qy)] && below(qx, qy) && !space[idx(qx, qy)] {
+                st.push((qx, qy));
+            }
+        }
+    }
+    let mut crater = vec![false; n];
+    let mut entry: Option<(i32, i32)> = None;
+    for x in x0..x0 + wd {
+        let mut roofed = false;
+        for y in y0..y1 {
+            let i = idx(x, y);
+            if space[i] {
+                let shaft = (x - door).abs() <= 1;
+                crater[i] = !shaft && !roofed;
+                if shaft && entry.is_none_or(|(ex, ey)| (y, x) < (ey, ex)) {
+                    entry = Some((x, y));
+                }
+            }
+            roofed |= !open[i];
+        }
+    }
+    let Some(entry) = entry else { return 0.0 };
+    // loose spoil with 3+ of 8 neighbours in the space counts as space, three rounds (`fill`)
+    for _ in 0..3 {
+        let add: Vec<usize> = (y0..y1)
+            .flat_map(|y| (x0..x0 + wd).map(move |x| (x, y)))
+            .filter(|&(x, y)| sp[idx(x, y)] && !space[idx(x, y)])
+            .filter(|&(x, y)| {
+                let mut k = 0;
+                for a in -1..=1 {
+                    for b in -1..=1 {
+                        k += ((a, b) != (0, 0) && inside(x + a, y + b) && space[idx(x + a, y + b)]) as i32;
+                    }
+                }
+                k >= 3
+            })
+            .map(|(x, y)| idx(x, y))
+            .collect();
+        if add.is_empty() {
+            break;
+        }
+        for i in add {
+            space[i] = true;
+        }
+    }
+    // the opening by a 5x5 block
+    let mut opened = vec![false; n];
+    for y in y0 + 2..y1 - 2 {
+        for x in x0 + 2..x0 + wd - 2 {
+            if (-2..=2).all(|a| (-2..=2).all(|b| space[idx(x + a, y + b)])) {
+                for a in -2..=2 {
+                    for b in -2..=2 {
+                        opened[idx(x + a, y + b)] = true;
+                    }
+                }
+            }
+        }
+    }
+    // 4-connected pieces of a mask: (cells, smallest (x, y)), biggest first
+    let pieces = |mask: &[bool]| -> Vec<Vec<usize>> {
+        let mut seen = vec![false; n];
+        let mut out: Vec<(usize, (i32, i32), Vec<usize>)> = Vec::new();
+        for x in x0..x0 + wd {
+            for y in y0..y1 {
+                let i = idx(x, y);
+                if !mask[i] || seen[i] {
+                    continue;
+                }
+                seen[i] = true;
+                let mut comp = vec![i];
+                let mut q = VecDeque::from([(x, y)]);
+                while let Some((px, py)) = q.pop_front() {
+                    for (a, b) in N4 {
+                        let (qx, qy) = (px + a, py + b);
+                        if inside(qx, qy) && mask[idx(qx, qy)] && !seen[idx(qx, qy)] {
+                            seen[idx(qx, qy)] = true;
+                            comp.push(idx(qx, qy));
+                            q.push_back((qx, qy));
+                        }
+                    }
+                }
+                out.push((comp.len(), (x, y), comp));
+            }
+        }
+        out.sort_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)));
+        out.into_iter().map(|t| t.2).collect()
+    };
+    let rooms: Vec<Vec<usize>> = pieces(&opened).into_iter().filter(|r| 2 * r.iter().filter(|&&i| crater[i]).count() < r.len()).collect();
+    let xy = |i: usize| (x0 + (i as i32 % wd), y0 + (i as i32 / wd));
+    // body: the main room, the door's shortest way down to it, and the crater
+    let mut dist = vec![u32::MAX; n];
+    let mut par = vec![usize::MAX; n];
+    dist[idx(entry.0, entry.1)] = 0;
+    let mut q = VecDeque::from([entry]);
+    while let Some((px, py)) = q.pop_front() {
+        for (a, b) in N4 {
+            let (qx, qy) = (px + a, py + b);
+            if inside(qx, qy) && space[idx(qx, qy)] && dist[idx(qx, qy)] == u32::MAX {
+                dist[idx(qx, qy)] = dist[idx(px, py)] + 1;
+                par[idx(qx, qy)] = idx(px, py);
+                q.push_back((qx, qy));
+            }
+        }
+    }
+    let mut body = vec![false; n];
+    if let Some(main) = rooms.first() {
+        for &i in main {
+            body[i] = true;
+        }
+        let mut p = *main.iter().min_by_key(|&&i| (dist[i], xy(i))).unwrap();
+        while par[p] != usize::MAX {
+            p = par[p];
+            body[p] = true;
+        }
+    } else {
+        body[idx(entry.0, entry.1)] = true;
+    }
+    for i in 0..n {
+        body[i] |= crater[i];
+    }
+    let mut reach = vec![0u32; n];
+    let mut seen = body.clone();
+    let mut q: VecDeque<usize> = (0..n).filter(|&i| body[i]).collect();
+    while let Some(i) = q.pop_front() {
+        let (px, py) = xy(i);
+        for (a, b) in N4 {
+            let (qx, qy) = (px + a, py + b);
+            if inside(qx, qy) && space[idx(qx, qy)] && !seen[idx(qx, qy)] {
+                seen[idx(qx, qy)] = true;
+                reach[idx(qx, qy)] = reach[i] + 1;
+                q.push_back(idx(qx, qy));
+            }
+        }
+    }
+    let rest: Vec<bool> = (0..n).map(|i| space[i] && !body[i] && !opened[i]).collect();
+    let mut tun: Vec<u32> = pieces(&rest).iter().map(|c| c.iter().map(|&i| reach[i]).max().unwrap_or(0)).filter(|&t| t > 2).collect();
+    tun.sort_unstable_by(|a, b| b.cmp(a));
+    let t: f64 = tun.iter().take(4).map(|&t| (t - 2).min(15) as f64).sum();
+    t + rooms.iter().skip(1).map(|r| r.len().min(50) as f64 / 2.0).sum::<f64>()
+}
