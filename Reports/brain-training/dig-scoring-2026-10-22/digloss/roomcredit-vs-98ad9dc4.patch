+/// Where [`of_world`]'s grid sits in the world: `(x0, y0, w)`, so a harness can map a class or a
+/// [`cell_values`] entry at index `i` to the world cell `(x0 + i % w, y0 + i / w)` -- the room credit
+/// pays each value to whoever first cut that cell, from the harness's own cut log.
+pub fn grid_origin(world: &World, spec: &LabBox) -> (i32, i32, usize) {
+    let (xs, ys) = extents(world, spec);
+    (*xs.start(), *ys.start(), (xs.end() - xs.start() + 1).max(0) as usize)
+}
