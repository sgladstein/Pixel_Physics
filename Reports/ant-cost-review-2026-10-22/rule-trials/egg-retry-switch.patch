+/// **How long an ant whose egg walk found no site waits before walking
+/// again**, in frames: `PIXEL_PHYSICS_EGG_RETRY`, 0 (off: it walks every
+/// tick it could lay) when unset. A rule change under trial, not a
+/// speed-up: the ant cost review (2026-10-22) found 65-89% of ant ticks
+/// above the egg bar and 70-80% of those walks finding nothing, and at 24
+/// frames the walks fell 78% while births moved inside a 4.5x seed spread.
+/// What the ant gives up: a site that opens inside its wait goes to
+/// another ant. Unknown values panic.
+pub fn egg_retry_frames() -> u64 {
+    static V: std::sync::OnceLock<u64> = std::sync::OnceLock::new();
+    *V.get_or_init(|| match std::env::var("PIXEL_PHYSICS_EGG_RETRY").as_deref() {
+        Ok("") | Ok("off") | Err(_) => 0,
+        Ok(v) => v.parse().unwrap_or_else(|_| panic!("PIXEL_PHYSICS_EGG_RETRY={v:?}: use off or a number of frames")),
+    })
+}
