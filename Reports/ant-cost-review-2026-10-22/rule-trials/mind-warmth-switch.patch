+/// **Whether an option feels how warm its target is** ([`f::WARMTH`]):
+/// on by default; `PIXEL_PHYSICS_MIND_WARMTH=off` leaves the feature at 0
+/// and reads no temperature at all. A rule change under trial, not a
+/// speed-up: the ant cost review (2026-10-22) found the feature exactly 0
+/// on 84-89% of options and under 0.01 on 99% in the mind colony, while its
+/// reads were 5% of the frame. Unknown values panic.
+pub fn warmth_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| match std::env::var("PIXEL_PHYSICS_MIND_WARMTH").as_deref() {
+        Ok("on") | Ok("") | Err(_) => true,
+        Ok("off") => false,
+        Ok(other) => panic!("PIXEL_PHYSICS_MIND_WARMTH={other:?}: use on or off"),
+    })
+}
