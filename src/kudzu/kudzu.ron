// **Kudzu, the Kudzu probe's vine** (`src/kudzu/`, 2026-11-07). Not a
// shipped species and deliberately not in `assets/species/`: registered at
// runtime by the game into its own world only (`World::species.register_ron`),
// so nothing that iterates the species registry -- worldgen, the lab, the
// species guards in `tests/*.rs` -- ever sees it.
//
// `creeper.ron` with these changes, each kept only after a look at the
// probe's two-wall box (`examples/kudzuprobe.rs mode=grow`):
//
//   light_weight 0.05 -> 0.35, upward_weight ~0 -> 0.35/0.25
//       the creeper declines the pull toward light because "a creeper that
//       chases light climbs, and climbing is the one corner of this envelope
//       that genuinely needs a mechanism". This one has the mechanism
//       (`plant::Climber`, which the game switches on for this species), so
//       it takes the pull.
//   continuation_weight 0.7 -> 0.5
//       less memory of its heading, so a stem turns to follow a wall face.
//   max_active_tips 14 -> 48, crowding_weight 30 -> 4
//       a sheet over a house front is many tips at once, packed close. At
//       30 the vine stood still through the whole three minutes on three
//       seeds of four (wall clear at the start and at dawn within 4 points);
//       at 4 it keeps spreading through play (seed 2: 53% clear -> 7%).
//   no seeds (`Reproduce` removed)
//       a vine here is one crown, one economy; seedlings made forty plants
//       in the first run and every count stopped meaning one vine.
//   no secondary thickening
//       with it the stems thickened into a solid grey wedge in the corner of
//       the wall, the upkeep of all that wood outran the leaves, and the vine
//       starved to death inside two minutes (2,472 cells -> 1,286, senescent).
//       A vine's stem stays a stem.
//   Photosynthesize 0.5 / 0.35 -> 1.0 / 1.4 (tip / leaf), Grow cost 0.2 -> 0.1
//       at the creeper's own numbers the vine never earned enough to cover
//       one wall face; at these it climbs one in the overnight run.
//
// The turgor numbers are the creeper's: a shoot out in open air still stops
// about eight rows along its stem from the crown. Within two cells of stone
// or ground it skips that bound (`Climber`).
(
    name: "kudzu",
    foliage_bands: (first: 2, count: 2),
    bark_bands: (first: 6, count: 2),
    stomatal_reserve: 0.2,
    fates: [
        (GrowingTip, [
            (when: Node,  becomes: DormantBud, child: Some(GrowingTip), lateral: Some(GrowingTip)),
            (when: Grew,  becomes: MatureBody, child: Some(GrowingTip), lateral: Some(GrowingTip)),
            (when: Stale, becomes: MatureBody),
        ]),
        (RootTip, [
            (when: Grew,  becomes: MatureBody, child: Some(RootTip), lateral: Some(RootTip)),
            (when: Stale, becomes: MatureBody),
        ]),
        (DormantBud, [
            (when: Flush, becomes: GrowingTip),
        ]),
    ],
    cell_types: [
        (Seed, [
            Germinate(
                light_threshold: 0.1,
                soil_water_threshold: 0.15,
                instant: false,
            ),
        ]),
        (GrowingTip, [
            Grow(
                cost: 0.1,
                branch_chance: [0.25, 0.35],
                continuation_weight: 0.5,
                light_weight: [0.35, 0.35],
                wind_weight: 0.1,
                upward_weight: [0.35, 0.25],
                crowding_weight: 4.0,
                max_active_tips: 48,
                plastochron: [2, 2],
                penetration_force: 0.0,
                turgor_source: 0.16,
                turgor_yield: 0.1,
                turgor_per_cell: 0.0075,
                turgor_taper: 0.35,
                heading_inertia: 0.05,
                branch_angle: [80.0, 75.0],
                internode: [2, 2],
                leaf_cluster: 14,
                juvenile_size: 20,
                juvenile_plastochron: 0.5,
                juvenile_branch: 1.3,
                genotype_variance: (0.5, 0.0, 0.4, 0.18, 0.7, 0.0, 0.4, 0.5, 0.0, 0.7),
                sympodial: [false],
                tropism: [Orthotropic],
            ),
            Photosynthesize(rate: 1.0, shade_death: 0.0, drought_death: 0.0),
        ]),
        (RootTip, [
            Absorb(rate: 1.5),
            Grow(
                cost: 0.25,
                branch_chance: [0.05],
                continuation_weight: 0.7,
                light_weight: [0.0],
                wind_weight: 0.0,
                upward_weight: [0.6],
                crowding_weight: 0.0,
                max_active_tips: 8,
                plastochron: [0],
                heading_inertia: 0.75,
                penetration_force: 1.2,
                genotype_variance: (0.0, 0.5, 0.0, 0.0, 0.0, 0.4, 0.0, 0.0, 0.25, 0.0),
            ),
        ]),
        (MatureBody, [
            StructuralAnchor,
            Absorb(rate: 1.5),
        ]),
        (DormantBud, [
            BudBreak(
                cost: 0.2,
                thickening_survival: 0.5,
                acrotony: 0.0,
            ),
            StructuralAnchor,
        ]),
        (Leaf, [
            Photosynthesize(rate: 1.4, shade_death: 0.00075, drought_death: 0.00075),
        ]),
    ],
)
