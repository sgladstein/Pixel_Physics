// S1 -- "Two larders", `Reports/lab-behaviour-scenarios-2026-09-06.md`.
// The cleanest scenario in the catalogue, and the one the report says to run
// first: one gene, one gradient, no ablation needed. Two rooms of the same
// jar, one fed plant matter and one fed flesh -- gut_bias is a single
// heritable scalar and the 4x diet-quality curve pays for specialising
// either way, so if the two compartments' gut means do not walk apart here,
// nothing further down the catalogue will separate either.
//
// **Colonies arrive on the timeline, not at build time.** `labshot
// scenario=two_larders frames=0,600` used to show a founder eaten by frame
// 600: with `Colony` in `placements`, the ants and the four herb founders
// land on the same frame, and a founder is not a plant yet. Both colonies
// now found at frame 3,000 instead, at the same columns, giving the herbs a
// head start to grow before anything eats them.
//
// **Heap sizes come from the colony's idle burn, not a guess.** An ant
// idles at 0.10 energy/tick (`Reports/...`'s own measured rate), so 52 ants
// burn 52 * 0.10 * 6000 = 31,200 energy over a 6,000-frame window. Measured
// at frame 600 of the previous (12/24-cell) build, both starting heaps were
// already gone with 19 ants carrying food -- a 24-cell corpse heap is only
// 11,520 energy, under half of one window's burn, so both rooms starved
// toward zero before any gut could drift. Sized instead to feed about 40
// ants idling plus a few births: windfall is 960 energy/cell and corpse is
// 480, so 30 cells of windfall (28,800) and 60 cells of corpse (28,800) each
// cover 92.3% of the 31,200 burn per window -- close enough that births push
// it the rest of the way without the room ever running empty long enough to
// starve the colony out. Both heaps are this size at build time and on
// every 6,000-frame repeat.
(
    name: "two_larders",
    title: "TWO LARDERS",
    question: "Left room eats plants, right room eats flesh -- does one ant colony split into two gut-bias lineages?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 96,
        ground_y: 160,
        compartments: 2,
        founders: 0,
        species: "herb",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [],
    placements: [
        Plant(species: "herb", x: 60),
        Plant(species: "herb", x: 100),
        Plant(species: "herb", x: 160),
        Plant(species: "herb", x: 200),
        Heap(material: "windfall", x: 180, cells: 30),
        Heap(material: "corpse", x: 330, cells: 60),
    ],
    timeline: [
        (at: 3000, every: 0, until: 0, what: Colony(species: "ant", x: 120, count: 52)),
        (at: 3000, every: 0, until: 0, what: Colony(species: "ant", x: 390, count: 52)),
        (at: 6000, every: 6000, until: 0, what: Heap(material: "windfall", x: 180, cells: 30)),
        (at: 6000, every: 6000, until: 0, what: Heap(material: "corpse", x: 330, cells: 60)),
    ],
    horizon: 60000,
)
