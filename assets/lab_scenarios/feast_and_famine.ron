// S2 -- "Feast and famine", `Reports/lab-behaviour-scenarios-2026-09-06.md`.
// Two rooms of the same jar again, this time fed the *same total food* on
// two different schedules: the left compartment gets 4 cells of windfall
// every 1,000 frames, the right gets 48 cells every 12,000 -- 48 cells
// either way, over any 12,000-frame window. If life-history strategy is
// selectable at all, a steady trickle and a boom-and-bust cycle should pull
// crop_capacity, reproduce_at, birth_grant, digest_rate and pace apart, and
// which direction each moves is the experiment.
//
// No plants and no build-time heap: every mouthful in this bed comes off the
// timeline, which is the whole reason it needed the scenario file rather
// than a hand-played bed (`Reports/lab-behaviour-scenarios-2026-09-06.md`
// §4 item 1's worked example).
(
    name: "feast_and_famine",
    title: "FEAST AND FAMINE",
    question: "Same food over 12,000 frames, delivered as a trickle on one side and a monthly boom on the other -- which life history wins each room?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 96,
        ground_y: 160,
        compartments: 2,
        founders: 0,
        species: "herb",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [],
    placements: [
        Colony(species: "ant", x: 120, count: 52),
        Colony(species: "ant", x: 390, count: 52),
    ],
    timeline: [
        (at: 1000, every: 1000, until: 0, what: Heap(material: "windfall", x: 140, cells: 4)),
        (at: 1000, every: 12000, until: 0, what: Heap(material: "windfall", x: 410, cells: 48)),
    ],
    horizon: 60000,
)
