// The nest goal bed -- the owner's goal of 2026-10-03, as a box.
//
// The owner, 2026-10-03: a lab colony with a stable (or at least not dying)
// population that over time digs a nest of several actually separate
// chambers, big enough for all the food, brood and workers, with food and
// brood somewhat organised. **No plants**, so nothing but the colony moves
// the ground; food is the player's own FOOD brush (`provisions`, never
// rots) in one fixed spot 30 columns east of the nest, at the surface.
//
// Same box as `played_bed` (the size, soil, lamps and mister the owner
// plays), the same colony on the same timeline (52 asked for at frame
// 6,000, column 256). The scenario places one heap of provisions when the
// colony lands; `examples/nestgoal.rs` keeps that heap topped up so it
// never runs out, and reports the goal readout. In the app the heap is
// placed once and the player tops it up by hand, as in a playtest.
(
    name: "nest_goal",
    title: "THE NEST GOAL",
    question: "No plants, endless food in one spot beside the nest: does the colony hold steady and dig separate chambers for food, brood and workers?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 80,
        ground_y: 160,
        compartments: 1,
        founders: 0,
        species: "grass",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [],
    placements: [],
    timeline: [
        (at: 6000, every: 0, until: 0, what: Colony(species: "ant", x: 256, count: 52)),
        (at: 6000, every: 0, until: 0, what: Heap(material: "provisions", x: 286, cells: 120)),
    ],
    horizon: 300000,
)
