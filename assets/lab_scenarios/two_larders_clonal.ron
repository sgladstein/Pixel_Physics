// S1's control arm -- "Two larders", mutation off.
//
// `two_larders.ron` with one setting added: the ant's `mutation_rate` at 0.0.
// Everything else is byte-for-byte the same bed, so the two files are a
// paired comparison in the sense `CLAUDE.md` asks for -- same seeds, same
// rooms, same larders, and only the thing under test differs. What this arm
// measures is how far the two rooms' gut means walk apart when nothing new
// can arise: any drift here is survivorship of the founders' standing
// variation, so the live arm's paired difference minus this arm's is the
// part selection on new mutation is buying.
//
// Run it the way the live arm is run, and read the two together:
//   labbatch scenario=two_larders        arm=seeded runs=8
//   labbatch scenario=two_larders_clonal arm=seeded runs=8
//
// Shipped as its own file rather than a switch on the live one because a
// scenario is a saved starting box, and "the same box with mutation off" is
// exactly the kind of thing the rack should be able to open beside it.
(
    name: "two_larders_clonal",
    title: "TWO LARDERS CLONAL",
    question: "Two larders with mutation off -- how far do the rooms' guts drift apart on standing variation alone? Read beside the live arm.",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 96,
        ground_y: 160,
        compartments: 2,
        founders: 0,
        species: "herb",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [
        (subject: "ant", field: "mutation_rate", value: 0.0),
    ],
    placements: [
        Plant(species: "herb", x: 60),
        Plant(species: "herb", x: 100),
        Plant(species: "herb", x: 160),
        Plant(species: "herb", x: 200),
        Heap(material: "windfall", x: 180, cells: 30),
        Heap(material: "corpse", x: 330, cells: 60),
    ],
    timeline: [
        (at: 3000, every: 0, until: 0, what: Colony(species: "ant", x: 120, count: 52)),
        (at: 3000, every: 0, until: 0, what: Colony(species: "ant", x: 390, count: 52)),
        (at: 6000, every: 6000, until: 0, what: Heap(material: "windfall", x: 180, cells: 30)),
        (at: 6000, every: 6000, until: 0, what: Heap(material: "corpse", x: 330, cells: 60)),
    ],
    horizon: 60000,
)
