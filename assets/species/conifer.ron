// A Massart-model conifer: monopodial orthotropic trunk under plagiotropic
// branch tiers -- the fir/spruce silhouette, and the first species to
// exercise `Tropism` at all. Everything economic (cost, income, pipe
// ratio, shedding) is inherited from tree.ron's derivations in the
// normalised node units, so this file is *architecture*, not a re-tune:
// what differs from `tree` is which way each tier points, how straight it
// grows, and how its buds renew.
//
// Judged by sheet against `tree` in the same scene (see the Phase 2
// commit): the discriminating look is horizontal branch tiers off a
// single straight bole. The `plagiotropic_steps` counter in `plant_probe`
// is the proof the tiers actually ran -- a conifer whose counter reads
// zero is a mislabelled poplar.
(
    name: "conifer",
    // The blue-green end of the foliage axis on dark red-brown bark -- the
    // fir/spruce reading, and disjoint from `tree`'s range so the two
    // species never draw the same colour however the individuals fall.
    foliage_bands: (first: 0, count: 2),
    bark_bands: (first: 1, count: 2),
    // See tree.ron: the stock fraction where stomata start closing,
    // multiplied per individual by genotype slot 7.
    stomatal_reserve: 0.2,
    cell_types: [
        (Seed, [
            Germinate(
                light_threshold: 0.1,
                moisture_threshold: 0.0,
                instant: false,
            ),
        ]),
        (GrowingTip, [
            Grow(
                cost: 0.2,
                // The trunk almost never forks; tiers branch densely --
                // needle sprays off limbs.
                branch_chance: [0.07, 0.09, 0.12, 0.14],
                continuation_weight: 0.7,
                // Branch tiers hold their plane rather than chasing light
                // upward -- phototropism stays modest on purpose, or every
                // tier curls skyward and the silhouette is a poplar again.
                light_weight: [0.1, 0.1, 0.15, 0.2],
                wind_weight: 0.15,
                // For the orthotropic trunk this is "up"; for the
                // plagiotropic tiers the same weight pulls *outward* along
                // the tier's own departure direction (see
                // organism::Tropism). Strong on both: a fir is straight in
                // every axis it has.
                upward_weight: [1.0, 0.5, 0.4, 0.3],
                crowding_weight: 30.0,
                max_active_tips: 14,
                // Trunk bare by plastochron, tiers needle-dense.
                plastochron: [14, 3, 2, 2],
                penetration_force: 0.0,
                // Taller and slimmer than tree.ron: h_max = (1.0 - 0.1) /
                // 0.006 = 150 rows.
                turgor_source: 1.0,
                turgor_yield: 0.1,
                turgor_per_cell: 0.006,
                turgor_taper: 0.25,
                // A conifer leader barely wanders.
                heading_inertia: 0.8,
                // **Tiers leave the bole near-perpendicular and run.** This
                // is the fir silhouette stated as data rather than hoped
                // for from `tropism` alone: 85 degrees off the leader, then
                // ten cells before light or gravity get a vote.
                //
                // Worth watching against the open lean bug (§4 of the
                // night-session handoff): a tier that holds its departure
                // direction for ten steps cannot be walked sideways by the
                // sign-of-heading ratchet in that time. If the lean
                // survives this it is not accumulated drift.
                branch_angle: [85.0, 60.0, 45.0, 45.0],
                internode: [0, 10, 5, 3],
                // Needle sprays read smaller than broadleaf clusters -- the
                // ratio against `tree`'s is what carries that, so both moved
                // together when foliage volume was raised (see tree.ron's
                // note on why this is now a pure appearance knob). 3 -> 6.
                leaf_cluster: 6,
                juvenile_size: 60,
                juvenile_plastochron: 0.25,
                juvenile_branch: 1.5,
                // Slots 6-8 appended and 1/5 re-purposed to the root
                // vector at the 2026-08-18 re-map -- tree.ron carries the
                // full note.
                genotype_variance: (0.4, 0.0, 0.3, 0.15, 0.5, 0.0, 0.4, 0.5, 0.0),
                sympodial: [false],
                // The lever this species exists for: an orthotropic trunk
                // under plagiotropic everything-else.
                tropism: [Orthotropic, Plagiotropic, Plagiotropic, Plagiotropic],
            ),
            Photosynthesize(rate: 0.5, shade_death: 0.0, transpiration: 0.05, drought_death: 0.0),
        ]),
        (RootTip, [
            Absorb(rate: 1.5),
            // **No `Transpire` here any more.** It drained adjacent soil
            // and credited nothing, which was the right stand-in while
            // water was not a currency -- it was the only thing making a
            // stand dry the ground at all.
            //
            // It is a double count now. Transpiration is a single path,
            // soil -> root -> leaf -> air: `Absorb` moves soil into the
            // plant and the foliage's `transpiration` demand moves it out
            // to the air. A second uncredited soil->air drain alongside
            // that corresponds to nothing, and it would make the ground dry
            // faster than the plants actually use it.
            //
            // If the resulting drawdown is too weak to steer roots
            // hydrotropically, the honest lever is the foliage demand, not
            // a phantom drain.

            Grow(
                cost: 0.25,
                // **Superseded by `branch_priming` below.** A root tip's
                // in-tick branch roll demanded a second step's carbon in
                // the tick the first was paid; it cleared that twice in
                // twelve thousand frames and fired zero times. Zero here
                // rather than left at its old value so nothing reads as a
                // live knob that no longer runs -- see
                // `Behavior::Grow::branch_priming`.
                branch_chance: [0.0],
                continuation_weight: 0.7,
                light_weight: [0.0],
                wind_weight: 0.0,
                upward_weight: [0.6],
                crowding_weight: 0.0,
                max_active_tips: 10,
                plastochron: [0],
                // Steps between primed lateral sites, swept at landing over
                // 1/2/3/6/12/24: root mass falls monotonically as the
                // interval widens (755 cells at 1, 336 at 6) because a
                // sparser mark leaves the conversion with nothing available
                // to pick most ticks. 3 rather than 1 because 1 stops being
                // an oscillator -- it primes every cell, and the walk then
                // re-scans 82,487 primed cells over a run against 1,160 at
                // 3, for a stand-scale cost the mechanism does not need.
                // 3 also puts genotype slot 1 on the responsive part of the
                // curve, which is what lets the trait order an outcome at
                // all.
                branch_priming: [3],
                heading_inertia: 0.75,
                penetration_force: 1.2,
                // The root's own genome vector, slots 1/5/8 -- tree.ron's
                // RootTip entry carries the full derivation of the widths.
                genotype_variance: (0.0, 0.5, 0.0, 0.0, 0.0, 0.4, 0.0, 0.0, 0.25),
            ),
        ]),
        (MatureBody, [
            // **Set seed.** The rate is per mature cell, so a plant's
            // fecundity is its canopy size times this -- size buys
            // offspring with no rule saying so, which is what makes
            // selection on every other trait mean anything.
            //
            // Rates are a first pass and explicitly untuned against an
            // outcome: they want a sweep once a population has run long
            // enough to measure generations per unit time.
            Reproduce(seed_cost: 0.3, seed_chance: 4e-05, seed_maturity: 700),
            SecondaryThicken(pipe_ratio: 5.5),
            StructuralAnchor,
            // Same water economy as tree.ron -- see its own entries for
            // why each of these exists. Kept identical across the three
            // species deliberately: the megastudy compares them, and a
            // species that silently sat out the economy would look like a
            // morphology result.
            Absorb(rate: 1.5),
        ]),
        (DormantBud, [
            BudBreak(
                cost: 0.2,
                thickening_survival: 0.2,
                // Mildly acrotonous: renewal stays in the crown, the way a
                // conifer keeps its leader.
                acrotony: 0.8,
            ),
            StructuralAnchor,
            SecondaryThicken(pipe_ratio: 5.5),
        ]),
        (Leaf, [
            Photosynthesize(rate: 0.35, shade_death: 0.003, transpiration: 0.05, drought_death: 0.003),
        ]),
    ],
)
