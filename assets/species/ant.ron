// The first colony creature (Reports/creature-direction.md D2). A chain of
// cells on the organism substrate, deciding with the fixed-scaffold brain
// in `brain.rs`, whose weights are this file's `instincts` list and nothing
// else -- there is no ant-specific behaviour code branching on species.
//
// **Generation zero must already forage.** That is the entire point of
// authored instincts: the colony works on day one exactly as a brainless
// taxis design would have, and evolution (stage 4) refines rather than
// bootstraps. If the ant below mills instead of foraging, the thing to fix
// is these weights, not the mutation rate.
//
// Both cell types carry no `Behavior`s, same as worm.ron: movement,
// sensing and the four verbs are creature.rs's code. A `Behavior` is
// something a species composes onto a cell type from data, and none of
// this is that.
(
    name: "ant",
    cell_types: [
        (Head, []),
        (Segment, []),
    ],
    creature: Some((
        // Two cells. Owner open question #1 is whether an ant reads at one
        // cell or needs a chain at play zoom; two is the cheapest thing
        // that is unambiguously a *body* with a front, and it is one
        // number here to change once that has been looked at.
        body_cells: 2,
        tick_interval: 6,

        // Scaled from the worm's researched numbers (creature.rs's WORM_*
        // block): idle 0.3, open-ground move 1.0. An ant is smaller and
        // cheaper to run than a worm and has to complete round trips, so
        // it gets a longer budget against a lighter idle cost. These are
        // the knobs a colony that starves too fast is tuned with.
        start_energy: 900.0,
        idle_cost: 0.10,
        move_cost: 0.25,

        // Per active synapse per tick. Against idle_cost 0.10, a
        // fully-dense brain (~168 connections) costs about a third of
        // standing still and the authored sparse brain below (11
        // connections) costs about 2%. The magnitude is not the point --
        // the *sign* is: a connection that does not pay for itself gets
        // pruned, which is both the sparsity pressure that keeps evolved
        // brains legible and a real energetic trade-off.
        synapse_cost: 0.002,
        eat_energy: 120.0,
        // Eat only when genuinely low; otherwise carry it home. See
        // CreatureDef::hunger_fraction -- getting this wrong deletes the
        // foraging loop while leaving a colony that looks right.
        hunger_fraction: 0.5,

        // **Detritus only, for now.** Owner open question #2: herbivory on
        // live plants from day one, or corpse/seed only until the plant
        // damage interaction has been watched once? This is the
        // conservative default and the difference is literally adding
        // "leaf" to this list -- herbivory needs no new code, because a
        // Leaf cell is just a cell and the plant discovers the loss
        // through its own connectivity check.
        food: ["corpse", "seed"],
        nest: "nest",

        // Against Material::penetration_resistance, the pattern roots
        // already use rather than a material-name whitelist. 1.0 chews
        // soil (0.8) and nothing harder -- not sand (1.4), not gravel
        // (3.5), not stone. So a colony excavates its chamber out of soil
        // and is stopped by rock, which is the behaviour worth having and
        // it comes from two numbers rather than from a rule.
        dig_force: 1.0,

        // Ticks over which nest scent fades to nothing.
        //
        // **3000, not 600, and the short value silently deleted homing.**
        // The gradient only extends as far as an ant with nest memory
        // left can walk, so at 600 ticks channel A stopped well short of
        // the food -- measured at exactly 0 in the food third of the
        // scene, while channel B piled up to 4,293 there. Carriers were
        // arriving, picking food up and then milling on the spot, because
        // at the one place they needed a signal pointing home there was
        // none. 31 pickups, 0 deliveries.
        //
        // It has to exceed the *travel* time to the far side of the
        // foraging range, not the round trip: an ant lays this outbound.
        nest_memory: 3000,

        // Measured, not assumed: pheromone.rs's trail_following_sweep puts
        // on-trail tracking at 0.817 for 6, against 0.755 at 4, 0.743 at 8
        // and 0.727 at 10.
        sensor_offset: 6,

        // The authored brain. Everything not listed here is 0.0, which
        // under brain::W_EPS means "no connection", and the hidden layer
        // starts entirely silent.
        instincts: [
            // -- steering --------------------------------------------
            // Follow the food trail, and follow the nest scent. A single
            // layer cannot express "B when empty-handed, A when laden" as
            // a product -- that conditionality is exactly what the hidden
            // layer is for, and it is fine for generation zero to
            // approximate it additively: food trails exist where food is
            // and nest scent where the nest is, so in practice the two
            // gains rarely compete for the same ant in the same place. If
            // playtesting shows this milling, the honest fallback is one
            // *authored* hidden unit implementing the gate, written here
            // like any other weights -- not a special case in code.
            // **Both direct channel-to-turn gains are gone**, replaced by
            // the gated pairs in `hidden_wiring` below. Additively, a laden
            // ant still smelled the food trail it was itself laying and
            // walked away from home: 28 pickups, 28 ants still carrying at
            // the end, mean position x=208 against a nest at x<120. The
            // report predicted this exactly and named the fix.
            // (PheroBLateral, Turn, ...) -- now via hidden units 2 and 3
            // (PheroALateral, Turn, ...) -- now via hidden units 0 and 1
            // Flee heat. The worm's thermotaxis, kept, because it is the
            // same animal problem and it costs one connection.
            (TempAboveAmb, Turn, -0.8),

            // -- going anywhere at all -------------------------------
            // 2.0, not 0.7. squash() is what makes this a measurement
            // rather than a taste: a gain of 0.7 becomes P(move) = 0.35,
            // so an ant steps about once every 17 frames and a colony
            // takes thousands of frames to cross its own scene. Measured
            // at 0.7: 3634 moves and *zero* food found in 2000 frames.
            // 2.0 gives P(move) = 0.67.
            // Baseline restlessness. Dropping this to 1.0 to leave the
            // gradient more room was tried and cost more than it bought:
            // an empty ant with no trail to read runs at P = 0.50 instead
            // of 0.67, and food discovery -- which is a *search*, and
            // depends on covering ground -- fell to a single pickup in
            // 12,000 frames. The gradient gets its authority from the
            // hidden gain below instead, which only applies when there is
            // actually a gradient to read.
            (Bias, Move, 2.0),
            // Stop when there is food to deal with.
            // -1.5, not -0.8: against the Bias of 2.0 this leaves P(move)
            // at 0.33 beside food rather than 0.55, so an ant lingers long
            // enough to actually pick something up instead of wandering
            // off. Not lower -- at -2.0 and beyond it stops dead and cannot
            // leave with its cargo.
            (FoodAdjacent, Move, -1.5),
            // **Negative feedback, and the colony ossifies without it**
            // (P-12): more evaporation does not substitute. A nonzero gain
            // here is load-bearing, and it is the first thing to check if
            // trails ever stop adapting.
            (Crowding, Move, -0.3),

            // -- what gets laid down ---------------------------------
            // Laden ants lay the food trail; that is what makes a
            // discovered patch recruit.
            // 2.5 and 2.0, not 0.9 and 0.3. squash() again: a gain of 0.3
            // deposits 11 of 255 per move, which evaporates inside 25
            // passes, so a trail only exists where many ants happen to
            // cross the same cell within a couple of seconds. Measured at
            // the old values: total channel A over the *whole world* was
            // 164 after 22,138 ant-moves -- a trail that was, for every
            // practical purpose, not there.
            (Carrying, EmitB, 2.5),
            // Everyone leaks nest scent. Scaled in code by how recently
            // this ant touched the nest, which is what turns a uniform
            // emission into a gradient that points home.
            (Bias, EmitA, 2.0),

            // -- the verbs -------------------------------------------
            // **A standing drive to dig, and its absence was a hole in the
            // authored brain rather than in the code.** With `FoodAdjacent`
            // as the only route to this output, an ant facing a bank of
            // soil computed a dig urge of exactly zero: the verb was
            // implemented, reachable, tested -- and never once fired,
            // measured at 0 digs against 19,114 moves and 27,928 blocked
            // ticks, a colony standing at a soil face doing nothing at all.
            // The picture of it looked like ants milling by a wall, which
            // is also what a broken dig would look like.
            //
            // Ants dig. It does not need a reason in the world; it needs a
            // reason in the animal.
            (Bias, Dig, 0.4),
            (FoodAdjacent, Dig, 0.8),
            (AtNest, Drop, 0.9),
            // Drop what you are carrying only when you have arrived; an
            // ant that drops at random is an ant that builds walls in the
            // middle of nowhere. Carrying alone must not be enough.
            (Carrying, Drop, 0.2),
        ],

        // **The gate a single layer cannot express**, authored as weights
        // rather than special-cased in code (report §4c's stated fallback).
        //
        // These four units were first wired to gate *steering* -- follow B
        // empty-handed, A when laden -- and gating worked while the signal
        // did not: on flat ground both lateral sensors sit in open air, so
        // the thing being gated was identically zero (report §13b). They
        // now gate the **run** instead, on the along-heading gradient,
        // which is what a surface-dweller can actually read.
        //
        // A single sigmoid cannot AND a *signed* signal with a gate --
        // saturate it and it fires on the signal alone. What works is a
        // **symmetric pair** per channel: two units sharing a gate, with
        // opposite polarity on the signal, wired to the output with
        // opposite signs. Ungated, both saturate to the same value and
        // cancel exactly; gated, they swing apart and reinforce. Worked
        // through for pair 0/1, with squash(x) = x/(1+|x|):
        //
        //   not carrying, A_along  0   : both squash(-5) = -0.833 ->  0.000
        //   carrying,     A_along  0   : both squash( 0) =  0.000 ->  0.000
        //   carrying,     A_along +0.5 : +0.750 and -0.750         -> +1.500
        //   carrying,     A_along -0.5 : -0.750 and +0.750         -> -1.500
        //
        // So a laden ant runs while the nest scent is strengthening ahead
        // of it and tumbles when it is not. Pair 2/3 is the same with the
        // gate inverted, so an empty ant runs up the food trail.
        // **Gate offsets of 30, and the size is the whole point.** A
        // symmetric pair cancels *exactly* only when both units sit at the
        // same point on the curve, so an ungated pair always leaks a
        // little of the signal it is supposed to be ignoring -- and a
        // little, applied every tick for thousands of ticks, is not
        // little. At an offset of 5 the leak was 0.27 and empty ants
        // clustered on the nest immediately; at 12 it was 0.09 and the
        // colony still collapsed back onto the nest over 12,000 frames,
        // visible as channel A in the middle third falling from 8,667 to
        // 798 as the ants retreated. At 30 both units sit at -0.967 and
        // -0.971 and the leak is 0.004, while the *gated* swing is
        // unchanged at 1.5 -- deep saturation costs the gate nothing and
        // buys the cancellation.
        hidden_wiring: [
            // units 0,1 -- channel A along the heading, gated ON carrying
            (Bias,        0, -30.0),
            (Carrying,    0,  30.0),
            (PheroAAlong, 0,   6.0),
            (Bias,        1, -30.0),
            (Carrying,    1,  30.0),
            (PheroAAlong, 1,  -6.0),
            // units 2,3 -- channel B along the heading, gated OFF carrying
            (Carrying,    2, -30.0),
            (PheroBAlong, 2,   6.0),
            (Carrying,    3, -30.0),
            (PheroBAlong, 3,  -6.0),
        ],
        // 2.5 against a baseline of 2.0, so the gated pair can drive the
        // run probability the whole way to zero rather than merely dent
        // it: a laden ant heading away from the nest computes
        // squash(2.0 - 3.75) < 0, clamps to P(move) = 0 and does nothing
        // but tumble until it is pointed somewhere better, while one
        // heading home runs at 0.84. That ratio is the homing mechanism.
        hidden_outputs: [
            (0, Move,  2.5),
            (1, Move, -2.5),
            (2, Move,  2.5),
            (3, Move, -2.5),
        ],
    )),
)
