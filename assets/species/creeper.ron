// **A form probe, not a shipped species** (WP-C, `Reports/plant-
// implementation-plan.md`). It exists to answer one question by eye: does
// the Grow envelope already contain a *ground-runner* form class, reachable
// with no code and no new mechanism, or does everything this machinery
// grows read as another small tree?
//
// Pure values. Every field below exists and ships; nothing here is new.
// Three knobs carry the whole claim, and `organism.rs`'s own doc named the
// first of them before anyone tried it -- "a **vine** should be near `0.0`,
// a mature trunk near `0.9`":
//
//   heading_inertia 0.05  a stem with no momentum cannot hold a bole; it
//                         turns wherever the local score sends it
//   upward_weight   ~0    nothing pulls the axis vertical, so continuation
//                         and crowding decide, and both are lateral
//   turgor budget   8 rows  (0.16 - 0.1) / 0.0075 -- a hard ceiling a
//                         handspan off the ground, so length has nowhere
//                         to go but sideways
//
// Economy inherited from tree.ron unchanged, deliberately: if this reads as
// a different plant it must be the three knobs above doing it and not a
// re-tuned income. Judged against the four-axes bar in
// `Reports/plant-evolution-design.md` §4a -- size class, material/palette,
// form class, consequence -- and a verdict of "another small tree" is a
// deliverable, not a failure to fix.
(
    name: "creeper",
    // **Its own range at last.** This file shipped declaring `(first: 4,
    // count: 2)` on both axes -- byte-identical to `shrub.ron` -- with the
    // note below explaining that a probe does not need a palette. It stopped
    // being a probe the day worldgen started sowing it
    // (`Reports/plant-project-review-2026-08-23.md` A1), and a ground-runner
    // that is the same colour as the bush above it is the single cheapest
    // way to make a mixed world read as one species.
    //
    // Pale sage over a green-grey stem: desaturated where every other
    // species is saturated, which separates it from all four greens at a
    // glance rather than by hue alone. Bands 6-7 of both palettes are new
    // and are creeper's -- see `leaf.ron` for why the leaf axis steps off
    // its own hue ordering to make room.
    //
    // The original note still stands as far as it goes: a real ground layer
    // gets its own *materials* (WP-B3), which is an axis a recolour cannot
    // reach. This is the recolour, not that.
    foliage_bands: (first: 6, count: 2),
    bark_bands: (first: 6, count: 2),
    stomatal_reserve: 0.2,
    // **The production rule: what a cell becomes, and what it creates.**
    //
    // This is today's built-in behaviour written out (`plant::builtin_fate`
    // is the same answers in code, and a guard checks the two agree rule by
    // rule). Authored rather than left empty so the table has a real writer:
    // a channel that is read and never written is worse than one that is
    // written and never read, because every consumer of it is dead code that
    // looks alive.
    //
    // `child`/`lateral` are what a continuation and a branch are *created*
    // as. Both are `GrowingTip` here -- a tip's child is a tip -- and that is
    // the ceiling, not a detail: nothing today can change what a cell is
    // created as, which is why every species is a variation on one plant
    // however its placement is tuned. A determinate axis ending in an organ
    // sets `becomes` on `Stale`; a truss sets `lateral`.
    fates: [
        (GrowingTip, [
            // The metamer boundary: the retiring parent becomes the axillary
            // bud its leaf subtends. The leaf is placed beside the stem, not
            // in it.
            (when: Node,  becomes: DormantBud, child: Some(GrowingTip), lateral: Some(GrowingTip)),
            // An ordinary step: the tip retires the instant it grows, so the
            // frontier advances instead of radiating from static hubs.
            (when: Grew,  becomes: MatureBody, child: Some(GrowingTip), lateral: Some(GrowingTip)),
            // Aged out with nowhere to go. Same destination as the successful
            // path, deliberately -- and this is the site a determinate axis
            // actually retires through, since a terminal tip more often runs
            // out of room than grows one last time.
            (when: Stale, becomes: MatureBody),
        ]),
        (RootTip, [
            // A root has plastochron 0, so it never reaches `Node` -- no
            // leaves and no buds underground.
            (when: Grew,  becomes: MatureBody, child: Some(RootTip), lateral: Some(RootTip)),
            (when: Stale, becomes: MatureBody),
        ]),
        (DormantBud, [
            // The only mechanism in the engine that *creates* frontier.
            (when: Flush, becomes: GrowingTip),
        ]),
    ],
    cell_types: [
        (Seed, [
            Germinate(
                light_threshold: 0.1,
                // Low, like grass: a ground-hugging plant establishes on thin damp ground rather than waiting for a wet season.
                //
                // Plant-available soil water in the cell below, 0..1:
                // 0 is the permanent wilting point, 1 is field capacity.
                // Renamed from `moisture_threshold`, whose unit was the
                // field channel's 0..4 and which measured the wrong thing.
                soil_water_threshold: 0.15,
                instant: false,
            ),
        ]),
        (GrowingTip, [
            Grow(
                cost: 0.2,
                // Branch readily: a runner is many short axes, and with no
                // height to spend growth on, branching is where it goes.
                branch_chance: [0.25, 0.35],
                continuation_weight: 0.7,
                // Light barely steers it. A creeper that chases light
                // climbs, and climbing is the one corner of this envelope
                // that genuinely needs a mechanism (surface attraction) --
                // out of scope here, so the probe declines the pull rather
                // than half-expressing it.
                light_weight: [0.05, 0.05],
                wind_weight: 0.1,
                // The knob under test. Not negative -- that is the weeping
                // probe's question; here the axis simply has no vertical
                // preference at all and the horizon falls out of what is
                // left.
                upward_weight: [0.05, 0.0],
                crowding_weight: 30.0,
                max_active_tips: 14,
                plastochron: [2, 2],
                penetration_force: 0.0,
                // h_max = (0.16 - 0.1) / 0.0075 = 8 rows.
                turgor_source: 0.16,
                turgor_yield: 0.1,
                turgor_per_cell: 0.0075,
                turgor_taper: 0.35,
                // The second knob under test.
                heading_inertia: 0.05,
                // Wide departures and short runs: a mat spreads by turning
                // often, and a long straight internode is what a runner
                // does not have.
                branch_angle: [80.0, 75.0],
                internode: [2, 2],
                // **Deliberately left unset, and that is a choice rather
                // than an omission.** A vine is supposed to wander -- it is
                // the one shoot here authored at `heading_inertia: 0.05`,
                // i.e. no memory at all -- so rendering its heading as a
                // clean line would take away the thing that makes it read
                // as a creeper. `stem_stiffness` is species identity, not a
                // global improvement, and this is the species that says so.
                // **The far end of the leaf-area-per-node axis** (item C2,
                // 2026-08-23): 8 -> 14, against conifer's 6 at nineteen
                // times this species' height budget. A runner spends nothing
                // on height, so the node it does build carries the broadest
                // leaf of the four -- which is also the only way a plant
                // eight rows tall reads as anything at all next to a stand
                // of conifers. See shrub.ron for why cluster size is
                // affordable to move and what it costs.
                leaf_cluster: 14,
                juvenile_size: 20,
                juvenile_plastochron: 0.5,
                juvenile_branch: 1.3,
                genotype_variance: (0.5, 0.0, 0.4, 0.18, 0.7, 0.0, 0.4, 0.5, 0.0, 0.7),
                sympodial: [false],
                tropism: [Orthotropic],
            ),
            Photosynthesize(rate: 0.5, shade_death: 0.0, drought_death: 0.0),
        ]),
        (RootTip, [
            Absorb(rate: 1.5),
            Grow(
                cost: 0.25,
                branch_chance: [0.05],
                continuation_weight: 0.7,
                light_weight: [0.0],
                wind_weight: 0.0,
                upward_weight: [0.6],
                crowding_weight: 0.0,
                max_active_tips: 8,
                plastochron: [0],
                heading_inertia: 0.75,
                penetration_force: 1.2,
                genotype_variance: (0.0, 0.5, 0.0, 0.0, 0.0, 0.4, 0.0, 0.0, 0.25, 0.0),
            ),
        ]),
        (MatureBody, [
            // **`seed_maturity` is SHOOT CELLS, not frames**, and at 250 this
            // species could not reproduce at all. Measured on
            // `reseed_probe founders=1 species=creeper frames=60000`: the
            // largest creeper in the run reaches **89 cells in total**, so a
            // 250-shoot-cell gate sits roughly five times above the ceiling
            // and the plant sets **zero seeds, ever** -- one founder, ten
            // columns held, nothing else in the bed. `grass.ron`'s header
            // already tells this story against itself ("at the drafted 150 no
            // grass plant could ever reproduce"); this is the same defect,
            // still live, on a second species.
            //
            // Swept through the live registry rather than by editing this
            // file and rebuilding, for the `include_str!` reason -- borne /
            // germinated / alive / columns over 60,000 frames:
            //
            //   250    0 /   1 /  1 /  10     <- as shipped
            //    40  267 /  97 / 29 /  81
            //    20  411 / 107 / 43 / 160
            //    10  411 / 107 / 43 / 160     <- identical to 20
            //
            // 20 takes the whole of the effect and 10 adds nothing, because a
            // creeper clears twenty shoot cells and the ten-cell gate on the
            // same tick. Set at **20**, the highest value that buys the full
            // result, so the gate still does the job it exists for -- stopping
            // a two-cell seedling breeding -- rather than being tuned to zero.
            Reproduce(seed_cost: 0.25, reproductive_allocation: 0.18, seed_maturity: 20),
            SecondaryThicken(pipe_ratio: 5.5),
            StructuralAnchor,
            Absorb(rate: 1.5),
        ]),
        (DormantBud, [
            BudBreak(
                cost: 0.2,
                thickening_survival: 0.5,
                acrotony: 0.0,
            ),
            StructuralAnchor,
            SecondaryThicken(pipe_ratio: 5.5),
        ]),
        (Leaf, [
            // **Leaf fall, at the rate the owner picked for `tree`.** This
            // line was byte-identical across conifer, shrub, creeper and
            // pre-retune `tree`: the three specialists inherited tree's
            // leaf economics wholesale and none was ever tuned on its own.
            // So when the owner chose the quarter rate on card
            // `20260823T161006584Z-6ecbab` ("C is best") he was choosing
            // this number, for the one woody species worlds sowed at the
            // time. PR #20 then started sowing all four, which left his
            // verdict covering a quarter of the world's woody flora and
            // the floor still filling from the rest -- measured on the
            // colony scene at 12,000 frames, soil-writing decay events ran
            // 5,061 with none of them cut, 2,954 with `tree` alone cut,
            // and 1,532 with all four. Carrying his rate across is
            // executing the answer he already gave, not a new call; if a
            // species should shed faster than the others that is a
            // separate, per-species decision and wants its own card.
            Photosynthesize(rate: 0.35, shade_death: 0.00075, drought_death: 0.00075),
        ]),
    ],
)
