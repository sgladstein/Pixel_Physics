// Spreads over damp, shaded stone (M16) — see `plant.rs`'s `moss_tick` and
// `research/m16-plant-biology.md` for why "damp and shaded" is the actual
// ecological driver (poikilohydric — no waterproof cuticle, no internal
// water regulation — rather than any directional or "north side" rule).
//
// Thin and light, and burns fast and cool relative to wood — a real fire
// carried by moss should flash through rather than smoulder, unlike a log.
(
    name: "moss",
    display: "Moss",
    kind: Plant,
    // Climbable. A mossy wall becomes a way up, which is a side effect
    // rather than the point; if it reads wrong in play this line comes out
    // and nothing else changes.
    climbable: true,
    density: 0.3,
    colors: [
        (58, 92, 46),
        (70, 104, 54),
        (48, 80, 38),
        (64, 98, 50),
    ],
    flammability: 0.4,
    burn_temperature: 500.0,
    burn_duration: 90,
    burns_into: "ash",
    heat_conductivity: 0.1,

    // Ground-level renewable food, and the only one an ant can
    // actually reach (13n: every preset ends a run with thousands of leaves
    // and 0-11 of them within three cells of the ground). **This value is
    // not free to choose**: moss divides at 0.35/tick into any free damp
    // shaded neighbour at zero cost, so a grazer that can sit and harvest
    // one patch faster than the patch regrows is a perpetual-motion machine
    // the moment food has value. Bounded by the sessile-grazer probe.
    food_energy: 480.0,
    // In MPa like every other value of this field. Live soft tissue: a
    // lamina punctures at almost nothing.
    penetration_resistance: 0.1,
    food_class: -1.0,
)
