// **The basement, and the occasional sill.** The hardest rock in the world,
// and the dark end of the value range against `limestone.ron`'s pale one --
// though the two are much closer than they were, spanning 79..178 where they
// once spanned 40..192. See the note above `colors` for why, and for what
// must not be compressed further.
//
// Two jobs. Below a fixed fraction of the massif every bed is basalt, so a
// shaft that goes deep enough arrives somewhere that looks different -- the
// only reward deep mining currently has. And a narrow window of the bed
// draw makes a basalt *sill* anywhere in the section, a black band cutting a
// pale one, which is the strongest single contrast a cliff face can show.
//
// Set relative to `stone.ron`; see
// `Reports/rock-vocabulary-design-2026-08-29.md` for the set.
(
    name: "basalt",
    display: "Basalt",
    kind: Solid,
    density: 2.9,

    //   0  fresh    near-black, blue-cool. Random picks stay here.
    //   1  weathered  basalt weathers to a dull brown rind, warm where the
    //      fresh rock is cold -- so an exposed basalt face reads brown and a
    //      cut one reads black, which is a large hue swing for a byte
    //      written once at genesis.
    // **These numbers are derived, not eyeballed, and the derivation is the
    // only way to change them safely.** Shown the six-rock world the owner
    // said twice, unprompted, *"the color changes between layers is too much.
    // There is too much contrast. There should be more of a shared color
    // palette"*, and on the first correction *"I would drop the contrast even
    // more"*. So every colour here is the file's original pulled 86% onto one
    // shared warm-grey hue -- the mean of the six rocks' fresh families,
    // renormalised to unit brightness -- after the whole material has been
    // shifted half way toward the global mean brightness.
    //
    // **The shift is per material, never per colour.** The four tones inside
    // one rock are what make a bed legible, and `stone.ron`'s own comment
    // records that squeezing *those* made the banding vanish from the render
    // entirely. Shifting the material bodily leaves every internal spread at
    // exactly its original value and compresses only the gap between rocks,
    // which is what the complaint was about: measured, that gap went from 116
    // brightness points to 57 while no rock's own spread moved at all.
    //
    // Full account and the b50 measurements either side:
    // `Reports/worldgen-relief-2026-08-30.md` section 5.5.
    colors: [
        // 0: fresh
        (99, 90, 84),
        (88, 80, 75),
        (114, 104, 97),
        (79, 72, 68),
        // 1: weathered -- rind
        (111, 100, 91),
        (101, 90, 82),
        (127, 113, 104),
        (92, 82, 75),
        // 2: **damp** -- rock below the water table, and rock a pond or a
        // stream is standing against.
        //
        // Derived rather than eyeballed, and stated so it can be re-derived:
        // family 0 multiplied by (0.78, 0.79, 0.83). Wet rock is darker
        // because the water film kills the diffuse scatter off the grain,
        // and it is *cooler* because the loss is smallest at the blue end --
        // so a single multiplier per channel says the whole thing, and no
        // rock in the set needs its own artistic judgement about being wet.
        // It is one byte, written at genesis, exactly like the other two.
        (85, 77, 73),
        (77, 70, 66),
        (97, 88, 84),
        (70, 63, 61),
    ],
    base_colors: 4,

    // The hardest thing that is not bedrock.
    max_unsupported_span: 22,
    attached_span_bonus: 14,
    support_cost_below: 1,
    support_cost_beside: 1,
    support_cost_above: 3,

    blast_resistance: 1.6,

    // {4, 8, 16, 32, 64}: columns, not slabs. Basalt's characteristic
    // fragment is tall and narrow rather than large, and the *shape* of that
    // comes from the joint fabric below rather than from the size ladder.
    fragment_floor: 2,
    fragment_rungs: 5,

    // Close-spaced cooling joints -- finer than stone's 13.
    //
    // `joint_band_contrast` is deliberately left at its 0.0 default here
    // even though columnar jointing is the one place a varied pitch would
    // genuinely earn its keep: `Material::joint_band_contrast`'s own note
    // measures it at **10-14 ms on the worst frame**, and frame cost is a
    // hard constraint in this repo rather than a tiebreaker. It is the first
    // thing to turn on if a blast in basalt ever needs to read differently
    // from a blast in stone, and it should be measured when it is.
    joint_spacing: 9.0,

    breaks_into: "rubble",
    heat_conductivity: 0.1,
    rock: true,
)
