// Architecture report §5f — the far end of the ash → soil decay path
// (`decay.rs`), closing the matter cycle `wood → ash → soil → wood` that
// used to be a one-way dead end. Loose enough to fall and pile like any
// other powder, not meant to feel packed or load-bearing.
(
    name: "soil",
    display: "Soil",
    kind: Powder,
    density: 1.3,
    friction_angle: 33.0,
    // Loose tilth: well under the 2-3 MPa penetrometer resistance at which
    // real root elongation stops (Da Silva/Kay/Perfect 1994), so roots grow
    // through it freely. See Material::penetration_resistance.
    penetration_resistance: 0.8,
    // Holds water in its pore space -- the only shipped material that does.
    // See Material::water_capacity for why this is opt-in rather than
    // universal, and material::SOIL_SATURATED for the scale (0 means dry,
    // the opposite of a Liquid's fill).
    water_capacity: 1000,
    // See Material::blast_resistance -- loose tilth, well under stone's 1.0.
    blast_resistance: 0.5,
    // **What an ant makes of it when it digs.** Loose tilth worked into the
    // wall of a gallery becomes `packedsoil`, which holds itself up -- see
    // that file's header for why a tunnel in this material is gone in five
    // frames without it. A property of the ground rather than a list in the
    // digger: `snow` is diggable at 1.0 too and must not become packed soil.
    packs_into: "packedsoil",
    // Three families of four tones, `family * 4 + tone`, keyed by the
    // region's aridity at genesis (`worldgen::passes::palette_family`).
    // Family 0 is exactly what this file shipped before families existed and
    // is where every *random* shade pick stays -- see `base_colors`, and see
    // `stone.ron` for the full reasoning.
    //
    // `passes::soil_shade` walks the tones as 2 -> 0 -> 1 -> 3, dark organic
    // topsoil down to paler mineral subsoil, and each family keeps that same
    // internal order so the profile reads the same wherever it is.
    //
    //   0  the reference loam
    //   1  wet -- darker and richer, the wetland/basin soil
    //   2  dry -- paler and dustier, kept well short of sand so a dry
    //      hillside still reads as soil and not as a sand sheet
    colors: [
        // 0: reference loam
        (64, 46, 34),
        (74, 54, 40),
        (56, 40, 30),
        (82, 60, 44),
        // 1: wet, dark and rich
        (52, 36, 24),
        (60, 43, 29),
        (44, 30, 20),
        (68, 49, 33),
        // 2: dry, pale and dusty
        (96, 80, 62),
        (108, 91, 71),
        (84, 70, 54),
        (118, 100, 78),
    ],
    base_colors: 4,
)
