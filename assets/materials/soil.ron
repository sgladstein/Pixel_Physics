// Architecture report §5f — the far end of the ash → soil decay path
// (`decay.rs`), closing the matter cycle `wood → ash → soil → wood` that
// used to be a one-way dead end. Loose enough to fall and pile like any
// other powder, not meant to feel packed or load-bearing.
(
    name: "soil",
    display: "Soil",
    kind: Powder,
    density: 1.3,
    friction_angle: 33.0,
    colors: [
        (64, 46, 34),
        (74, 54, 40),
        (56, 40, 30),
        (82, 60, 44),
    ],
)
