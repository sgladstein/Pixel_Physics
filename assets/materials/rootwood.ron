// Root tissue. A real material rather than shaded `wood`, and the reason is
// mechanical rather than cosmetic: `Reports/plant-substrate-v2-design.md`
// §6d's soil stabilization runs inside `update_powder`, which has a bare
// `Cell` and no way to reach organism state at all -- so "is the thing
// beside this grain a root" has to be answerable *from the material id*.
// Shading a `CellType` would not have been enough. §6a.
//
// Two other differences that are real physics, not decoration: buried wet
// tissue barely burns, and root wood is darker than a sunlit trunk.
(
    name: "rootwood",
    display: "Root",
    kind: Plant,
    // Climbable, and that is mostly about *not blocking*: a root threading
    // through soil used to stop a tunnel dead, since `mine` will not cut an
    // organism cell and `displace_disc` will not shove one. It still cannot
    // be dug -- it simply is not a wall any more.
    climbable: true,
    // **The same argument, for the other character.** The line above was
    // written about the gnome and left the ants where they were: a root
    // crossing a gallery stopped a colony dead, because an ant can neither
    // cut plant tissue (resistance 100 against a dig_force of 1.0) nor step
    // into it. And roots grow through open air already -- 79/1/28/21 root
    // cells measured inside a carved gallery over four seeds -- so the plug
    // was permanent and there was nothing the colony could do about it.
    //
    // Passable, still not diggable. Ants tunnel through the root plate,
    // roots grow across the galleries, and neither destroys the other; the
    // owner's framing was that either the two are mutually exclusive or one
    // goes through the other, and this is the third state. See
    // `Material::creature_passable` and open-bugs-handoff.md §Z4.
    //
    // **Built, measured, and left OFF -- 2026-09-03.** The mechanism works
    // (`an_ant_walks_through_a_root_and_leaves_it_standing`) and it should
    // not be switched on, for two measured reasons and not for a doubt:
    //
    // 1. **It buys nothing.** Blocked-move rate over four seeds, feature on
    //    against off from one binary: 0.089/0.076/0.075/0.074 against
    //    0.083/0.074/0.089/0.070. No direction. Ants meet roots **1, 5, 24
    //    and 31 times** in 9,000 frames -- roots are simply not what a
    //    colony is blocked by.
    // 2. **It costs trees.** An occluded cell reads as somebody else's to
    //    twelve separate plant passes, so while an ant stands in a root that
    //    root stops absorbing and stops conducting carbon. On a marginal
    //    tree that is fatal: seed 2 went 3,113 standing plant cells -> **4**
    //    on five occlusions.
    //
    // Turning it on again means first making those passes resolve through
    // `World::covered_at`, the way `plant::is_structural_anchor` already
    // does. The flag, the write seam and the guard are all still here for
    // that; only the opt-in is withdrawn.
    creature_passable: false,
    // Denser than trunk wood -- root tissue is water-saturated.
    density: 1.05,
    // Pale tan, not dark brown. Real roots are cream-to-tan and read pale
    // against dark earth, which is the accurate choice *and* the legible
    // one -- the first version of this file used (72,50,34), within a few
    // points of `soil`'s own (64,46,34), and an entire root system was
    // invisible in the game view while showing perfectly in the cell-type
    // overlay. A material whose whole justification is that it must be
    // distinguishable from its surroundings has to actually be
    // distinguishable from them.
    colors: [
        (168, 146, 112),
        (186, 164, 128),
        (150, 130, 98),
        (200, 180, 144),
    ],
    // Wet and underground: nearly unburnable. This is what stops a surface
    // fire from consuming a tree's whole root system through the soil, and
    // it is why a real burned-over forest resprouts from its roots at all
    // (`research/m16-plant-biology.md` §5's fire-resprouting note).
    flammability: 0.02,
    burn_temperature: 600.0,
    burn_duration: 600,
    burns_into: "ash",
    heat_conductivity: 0.12,
    // Holds the soil it threads through in place -- Wu-Waldron apparent
    // cohesion. See Material::reinforces_powder and update.rs's
    // root_reinforced.
    reinforces_powder: true,
    // Longer than trunk wood: a root is held on all sides by the soil it
    // grew through rather than cantilevered into open air.
    max_unsupported_span: 12,
    // Reach, not capacity -- see MaterialDef::max_cantilever_reach. Roots are
    // braced by the soil they thread, so they reach further than a branch.
    max_cantilever_reach: 128,
    breaks_into: "deadwood",
    // Same three tiers `wood.ron` carries, and for the same reason: a root
    // plate torn out of the bank is a piece, not a spray of grains. Roots
    // are thinner than a bole, so far fewer of their fragments will clear
    // `MIN_BODY_CELLS` -- which is the graded outcome doing its job rather
    // than a case needing its own numbers.
    fragment_floor: 5,
    woody: true,
    severs_into: "log",
)
