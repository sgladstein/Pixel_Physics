// **The lab ancestor's flesh** (`Reports/creature-genome-flexibility-2026-09-02.md`).
// A byte-copy of `ant.ron`'s material with the name changed, deliberately:
// this animal differs from the ant in its *genome and its senses*, and
// giving it a different body or a different food value would confound the
// one comparison the lab exists to make.
//
// It has its own entry at all only because `plant_creature_seed` resolves a
// creature's material by species name -- see `creature.rs`.
(
    name: "ancestor",
    display: "Ancestor",
    kind: Creature,
    density: 1.0,
    colors: [
        (38, 30, 28),
        (52, 42, 38),
        (28, 22, 20),
    ],
    flammability: 0.6,
    burn_temperature: 500.0,
    burn_duration: 40,
    burns_into: "corpse",
    heat_conductivity: 0.1,

    // Live flesh, for whatever eats an ant. Static rather than
    // per-individual because a creature cell's `aux` is already the organism
    // cell-type packing and cannot also carry a worth -- and predation has
    // never once fired (13o), so this number is close to unreachable today.
    // Flagged rather than dressed up.
    food_energy: 480.0,
    food_class: 1.0,
)
