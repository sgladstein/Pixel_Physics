// Tree trunk and root material (M16). `kind: Plant`, not `Solid` — plant
// cells never move via the CA sweep either way, and `Plant` lets other
// rules key on "is this alive" without checking the material name. `Cell::
// aux` was originally reserved separately for `Plant` (a future per-cell
// growth stage) versus `Solid` (M17's anchor distance); that growth-stage
// use never materialized -- real per-tip growth state lives in `TreeState`/
// `Tip`/`RootTip` (see `plant.rs`) instead, which is where it needed to be
// anyway (attractor lists and channel strength don't fit in a `u16`). With
// the slot actually free, architecture item 9 extends M17's anchor-distance
// tracking to cover `Plant` too — an unsupported trunk now breaks and falls
// the same way an unsupported stone span does.
//
// Flammable with real numbers, same as oil: wood is what turns a grown
// forest into an actual Drossel-Schwabl fire per the plan. Burns cooler and
// longer than oil (a log burns for a while, not in a flash) and, being
// mostly solid material rather than a thin liquid film, catches less
// readily per neighbour-check — flammability tuned below oil's 0.5.
(
    name: "wood",
    display: "Wood",
    kind: Plant,
    density: 0.9,
    colors: [
        (92, 64, 40),
        (105, 74, 46),
        (80, 55, 34),
        (114, 81, 51),
    ],
    flammability: 0.25,
    burn_temperature: 700.0,
    burn_duration: 420,
    burns_into: "ash",
    heat_conductivity: 0.15,
    // The plan's own suggested number for wood specifically ("stone 3,
    // wood 8, steel 20") -- unused until item 9 gave `Plant` a place to
    // read it from.
    max_unsupported_span: 8,
    breaks_into: "deadwood",
)
