// Angle of repose is the parameter that decides what a powder looks like at
// rest. Dry sand sits at roughly 34 degrees; raise this toward 45 for a
// sharper, more brittle pile, lower it for something that spreads out flat.
(
    name: "sand",
    display: "Sand",
    kind: Powder,
    // Loose, so roots pass -- but drier and less cohesive than soil, so a
    // little more resistant. Still under the 2-3 MPa bound.
    penetration_resistance: 1.4,
    density: 1.6,
    friction_angle: 34.0,
    // Three families of four tones, `family * 4 + tone`, keyed by the
    // region's aridity at genesis, with family 0 the palette this file
    // shipped with and the only one a *random* pick may use (`base_colors`;
    // `stone.ron` carries the full reasoning).
    //
    //   0  the reference sand
    //   1  pale cool sand -- the wet slot, which is not dead weight: the
    //      soil pass drops sand on wet valley floors as well as in deserts,
    //      and a lakeshore beach the colour of a dune reads as imported
    //   2  warm desert sand -- oranger, for the driest country
    colors: [
        // 0: reference
        (222, 196, 128),
        (212, 184, 116),
        (232, 208, 142),
        (204, 176, 110),
        // 1: pale cool shore sand
        (206, 198, 168),
        (196, 187, 157),
        (218, 210, 180),
        (188, 178, 148),
        // 2: warm desert sand
        (226, 180, 110),
        (216, 168, 99),
        (238, 194, 124),
        (208, 158, 92),
    ],
    base_colors: 4,
)
