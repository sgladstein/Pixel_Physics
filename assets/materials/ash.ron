// Fine and light, so it slumps almost flat and drifts through water rather
// than dropping straight down.
//
// This is oil's burns_into target, which makes heat_conductivity mandatory
// here even though most materials leave it at its 0.0 default: ash inherits
// whatever temperature the fire that produced it was burning at (900C for
// oil), and with zero conductivity that heat would have nowhere to go —
// permanently stuck above THERMAL_SETTLE_EPSILON, keeping its chunk awake
// forever. Any material that can end up as the target of burns_into,
// melts_into, boils_into, or a reaction needs a real value here for the same
// reason; only materials that can never receive elevated temperature this
// way are safe to leave at the default.
(
    name: "ash",
    display: "Ash",
    kind: Powder,
    density: 1.1,
    friction_angle: 22.0,
    heat_conductivity: 0.1,
    // Was hardcoded in `decay.rs` (ash -> soil, and only ash). Moved to data
    // when litter needed the same channel. Ash states no
    // `decay_chance_damp`/`_dry`, so it takes `decay.rs`'s defaults and every
    // ash measurement in that file still reads what it always did -- litter
    // is the material those knobs exist for.
    decays_into: "soil",
    // `decay.rs`'s old global `RESEED_CHANCE`, moved onto the material that
    // was the only one using it. Ash is rare -- something has to burn first
    // -- so 15% for a fresh soil cell to sprout reads as succession after a
    // fire rather than as a population explosion. Litter deliberately sets
    // 0: leaf fall under a standing canopy is not a succession event, and
    // this is a magnitude rather than a bool precisely because those two
    // callers differ by two orders of magnitude.
    reseed_chance: 0.15,
    colors: [
        (86, 82, 80),
        (98, 94, 92),
        (74, 71, 69),
        (92, 87, 84),
    ],
)
