+    fn rooms_trace(world: &World, organism: OrganismId, t: (i32, i32), feats: &[f32; FEATURES], fe: &[f32; DIG_ND], bonus: f32) {
+        use std::io::Write;
+        static OUT: std::sync::OnceLock<Option<std::sync::Mutex<std::io::BufWriter<std::fs::File>>>> = std::sync::OnceLock::new();
+        let Some(out) = OUT.get_or_init(|| std::env::var("PP_ROOMS_TRACE").ok().map(|p| std::sync::Mutex::new(std::io::BufWriter::new(std::fs::File::create(p).unwrap())))) else {
+            return;
+        };
+        let Some(top) = world.room_surface_at(t.0).or_else(|| world.nest_sites.first().map(|s| s.surface)) else { return };
