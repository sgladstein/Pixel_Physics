+        let mut o = out.lock().unwrap();
+        let f: Vec<String> = fe.iter().chain(feats.iter()).map(|v| format!("{v:.4}")).collect();
+        writeln!(o, "{},{},{},{},{verdict},{},{bonus:.3},{up},{dn},{gap_up},{gap_dn}", world.frame, organism, t.0, t.1, f.join(",")).unwrap();
+        o.flush().unwrap();
+    }
