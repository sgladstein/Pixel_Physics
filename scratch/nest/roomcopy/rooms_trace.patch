+        let up = (1..=8).take_while(|k| open(t.0, t.1 - k)).count();
+        let dn = (1..=8).take_while(|k| open(t.0, t.1 + k)).count();
+        let gap_up = (1 + up as i32..=8).find(|&k| open(t.0, t.1 - k) && !open(t.0, t.1 - k + 1)).unwrap_or(0);
