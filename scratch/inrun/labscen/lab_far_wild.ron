// SCRATCH (teacher lane, 2026-10-27, env1): lab_far_mix with the foods the game's own boxes feed on and training never
// offered -- windfall west (rots to soil in ~1,300 frames dry, so it rewards a fast search) and corpse east (flesh: a gut
// bred on plant food at -1 gets nothing from it, the authored ant's neutral gut gets a quarter). A selection case only:
// the exam's boxes (two_larders, scattered_larder, feast_and_famine) stay held out. Same bed, landing and heap timing.
(
    name: "lab_far_wild",
    title: "FAR FOOD, WINDFALL AND CARRION",
    question: "Food arrives at a fixed rate: does the colony settle at the size the income carries, or swing between boom and famine?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 80,
        ground_y: 160,
        compartments: 1,
        founders: 0,
        species: "grass",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [
        (subject: "the bed", field: "rain", value: 0),
    ],
    placements: [],
    timeline: [
        (at: 6000, every: 0, until: 0, what: Colony(species: "ant", x: 256, count: 52)),
        (at: 5990, every: 0, until: 0, what: Heap(material: "windfall", x: 106, cells: 60)),
        (at: 5990, every: 0, until: 0, what: Heap(material: "corpse", x: 406, cells: 60)),
        (at: 6500, every: 500, until: 0, what: Heap(material: "windfall", x: 106, cells: 20)),
        (at: 6500, every: 500, until: 0, what: Heap(material: "corpse", x: 406, cells: 20)),
    ],
    horizon: 600000,
)
