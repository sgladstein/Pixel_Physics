// SCRATCH (Teacher lane, 2026-10-25): the plants-only lab case -- herb_first_colony_near as is (herbs at the nest, grown
// 35,000 frames, 52 ants land; no food heaps). labsurvive after=15000, seeds 1-4, grant=1: hand-built ant lived 61.5-69.3,
// std_pool (price25b c10) 10.0-21.8; default grant seed 1: 55.9 vs 10.8. The trained ant does not eat more when hungry
// (Reports/brain-training/playtest/plant-forage-lab-2026-10-25/), so this is the case that can select for it.
// `herb_first_colony` with the herbs either side of the nest -- see that
// file for what both beds are for and why there are two.
(
    name: "lab_herbs",
    title: "THE FIRST COLONY ON A HERB BED, HERBS AT THE NEST",
    question: "Herbs alone, grown for 35,000 frames, then one colony of ants dropped on them. Who finds food, who eats, who banks enough to lay?",
    bed: (
        width: 512,
        height: 320,
        soil_depth: 80,
        ground_y: 160,
        compartments: 1,
        founders: 0,
        species: "herb",
        colonies: 0,
        colony_ants: 52,
        colony_species: "ant",
        predators: 0,
        lamp_spacing: 33,
        seed: 1,
        extra_walls: [],
    ),
    settings: [],
    placements: [
        // Two herbs either side of the nest column, so the colony lands in
        // their stand -- the playtest's nest band read 0 bare cells of 129 at
        // 40k. Food matched by worth: the owner's chronicle reads 9.4k /
        // 19.6k / 25.7k / 21.3k J at 10k / 20k / 30k / 40k; this reads 10.2k
        // / 24.7k / 30.0k / 33.2k on seed 1 (main 0bc13abb).
        Plant(species: "herb", x: 240),
        Plant(species: "herb", x: 270),
    ],
    timeline: [
        (at: 35000, every: 0, until: 0, what: Colony(species: "ant", x: 256, count: 52)),
    ],
    horizon: 100000,
)
